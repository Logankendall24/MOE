<% content_for :title_exact, "Standard designs selector" %>
<% content_for :full_bleed, true %>

<%# Ported verbatim from the supplied design (docs/design-imports/template-decoded.html,
    "Cover" screen). Inline styles, animation timings and copy are the design's own —
    only the data bindings have been swapped for ERB. %>

<div data-controller="cover" style="min-height:100vh;display:flex;flex-direction:column;background:#F1F3F2">
  <div data-screen-label="Cover" style="position:relative;min-height:100vh;background:#2C112D url('<%= asset_path "cover-background.png" %>') center center / cover no-repeat;color:#fff;display:flex;flex-direction:column;justify-content:space-between;gap:clamp(24px,4vw,48px);padding:clamp(28px,4.5vw,64px) clamp(28px,5vw,80px);animation:dcWipe 1.1s ease both">

    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:clamp(20px,4vw,48px);flex-wrap:wrap;animation:dcFade 0.9s ease 0.5s both">
      <%= image_tag "moe-logo.png", alt: "Te Tāhuhu o te Mātauranga — Ministry of Education", style: "width:clamp(190px,18vw,281px);height:auto;display:block" %>
      <div style="display:flex;align-items:flex-start;justify-content:flex-end;flex-wrap:wrap;gap:14px clamp(20px,2.8vw,48px);padding-top:clamp(14px,2vw,30px)">
        <% HomeController::NAV_TABS.each do |tab| %>
          <% common = 'display:flex;align-items:center;gap:12px;background:transparent;border:none;padding:0;color:#fff;cursor:pointer;transition:opacity 160ms ease' %>
          <% inner = capture do %>
            <span style="display:flex;flex-direction:column;align-items:flex-end;text-align:right;font:400 15px/1.2 Helvetica,Arial,sans-serif;white-space:nowrap">
              <span><%= tab[:reo] %></span>
              <span><%= tab[:label] %></span>
            </span>
            <span style="width:11px;height:11px;flex:none;border-right:1.3px solid #fff;border-bottom:1.3px solid #fff;transform:rotate(45deg);margin:-7px 4px 0 2px"></span>
          <% end %>

          <% case tab[:action] %>
          <% when :panel %>
            <button type="button" class="dc-navtab" style="<%= common %>" data-action="cover#openPanel" data-panel="<%= tab[:panel] %>"><%= inner %></button>
          <% when :external %>
            <%= link_to tab[:href], class: "dc-navtab", style: common, target: "_blank", rel: "noopener" do %><%= inner %><% end %>
          <% when :replay %>
            <%= link_to root_path, class: "dc-navtab", style: common, data: { turbo: false } do %><%= inner %><% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div style="max-width:100%;padding:clamp(12px,2vw,28px) 0">
      <h1 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(28px,5.4vw,84px);font-weight:800;line-height:1.02;letter-spacing:-0.032em;white-space:nowrap;animation:dcRise 0.9s ease 1.6s both">Great schools, great spaces</h1>
      <p style="margin:clamp(18px,2.4vw,30px) 0 0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(20px,2.3vw,32px);font-weight:700;line-height:1.22;letter-spacing:-0.015em;max-width:16em;animation:dcRise 0.9s ease 1.85s both">Standard designs for primary and intermediate schools</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-top:clamp(28px,3.6vw,46px);animation:dcRise 0.9s ease 2.2s both">
        <%= link_to "Select building module here →", questionnaire_start_path, class: "dc-cta", style: "display:inline-block;text-decoration:none;background:#fff;color:#2C112D;border:1px solid #fff;padding:18px 28px;font:500 12px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" %>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
      <%= image_tag "nz-govt-logo.png", alt: "Te Kāwanatanga o Aotearoa — New Zealand Government", style: "width:clamp(150px,13vw,215px);height:auto;display:block;animation:dcFade 0.9s ease 0.95s both" %>
      <div style="font-size:13px;line-height:1.5;max-width:30em;color:rgba(255,255,255,0.5);text-align:right;animation:dcFade 0.9s ease 2.5s both">He mea tārai e mātou te mātauranga kia rangatira ai, kia mana taurite ai ōna huanga</div>
    </div>
  </div>

  <% HomeController::PANELS.each do |key, panel| %>
    <div data-cover-target="panel" data-panel="<%= key %>" hidden style="position:fixed;inset:0;z-index:60;background:rgba(19,6,20,0.7);display:flex;justify-content:flex-end">
      <div style="width:min(580px,100%);height:100%;overflow:auto;background:#2C112D;border-left:1px solid rgba(255,255,255,0.25);padding:clamp(26px,4vw,52px);animation:dcSlide 0.35s ease both">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px">
          <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(26px,3vw,38px);font-weight:800;line-height:1.08;letter-spacing:-0.022em;color:#fff"><%= panel[:title] %></h3>
          <button type="button" class="dc-close" data-action="cover#closePanel" style="flex:none;background:transparent;border:1px solid rgba(255,255,255,0.4);color:#fff;padding:11px 14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase">Close</button>
        </div>
        <% panel[:blocks].each do |block| %>
          <div style="margin-top:26px;border-top:1px solid rgba(255,255,255,0.2);padding-top:16px">
            <div style="font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.55)"><%= block[:label] %></div>
            <p style="margin:11px 0 0;font-size:16px;line-height:1.55;color:rgba(255,255,255,0.86);text-wrap:pretty"><%= block[:text] %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
