<% selected = Array(draft["facilities"]) %>
<div class="space-y-3">
  <div class="flex items-start gap-3 border border-slate-200 bg-slate-50 p-4">
    <input type="checkbox" checked disabled class="mt-1">
    <span>
      <span class="block font-medium text-slate-900">Teaching spaces</span>
      <span class="block text-sm text-slate-500 mt-1">Always included — every school needs general teaching space.</span>
    </span>
  </div>

  <% [
       ["administration", "Administration", "Offices, reception, staff areas, meeting spaces"],
       ["library", "Library", ""],
       ["hall", "Hall", "Includes whare wānanga"],
       ["gym", "Gym", "Includes whare hākinakina"],
       ["specialist", "Specialist teaching spaces", ""],
       ["learning_support", "Learning support", ""]
     ].each do |value, label, hint| %>
    <label class="flex items-start gap-3 border border-slate-300 p-4 cursor-pointer hover:border-slate-500 has-[:checked]:border-slate-900 has-[:checked]:bg-slate-50">
      <input type="checkbox" name="draft[facilities][]" value="<%= value %>"
             <%= "checked" if selected.include?(value) %> class="mt-1">
      <span>
        <span class="block font-medium text-slate-900"><%= label %></span>
        <% if hint.present? %><span class="block text-sm text-slate-500 mt-1"><%= hint %></span><% end %>
      </span>
    </label>
  <% end %>
</div>
