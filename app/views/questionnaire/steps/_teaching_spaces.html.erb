<div class="grid sm:grid-cols-2 gap-6">
  <div>
    <label class="block text-sm font-medium text-slate-700">General teaching spaces required</label>
    <input type="number" min="0" name="draft[teaching_spaces_required]" value="<%= draft["teaching_spaces_required"] %>"
           class="mt-2 block w-full border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-slate-900">
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700">Specialist teaching spaces required</label>
    <input type="number" min="0" name="draft[specialist_spaces_required]" value="<%= draft["specialist_spaces_required"] %>"
           class="mt-2 block w-full border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:border-slate-900">
  </div>
</div>
<p class="text-xs text-slate-400">Optional — leave blank if not yet known.</p>
