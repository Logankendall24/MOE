<% content_for :title, @step_info[:title] %>

<div class="max-w-2xl mx-auto px-6 py-16">
  <%= render "progress" %>

  <h1 class="mt-8 text-2xl font-semibold text-slate-900"><%= @step_info[:title] %></h1>

  <p class="mt-3 text-sm text-slate-600 border-l-2 border-slate-300 pl-4">
    <span class="font-medium text-slate-700">Why we're asking:</span> <%= @step_info[:why] %>
  </p>

  <%= form_with url: questionnaire_step_path(@step), method: :patch, local: true, class: "mt-10 space-y-8" do %>
    <%= render "questionnaire/steps/#{@step.tr('-', '_')}", draft: @draft %>

    <div class="pt-6 flex items-center justify-between border-t border-slate-200">
      <%= link_to "← Start over", questionnaire_start_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
      <button type="submit" class="inline-flex items-center px-6 py-3 bg-slate-900 text-white text-sm font-medium hover:bg-slate-700">
        <%= @step == QuestionnaireController::STEPS.last ? "See relevant options" : "Continue" %>
      </button>
    </div>
  <% end %>
</div>
