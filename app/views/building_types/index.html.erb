<% content_for :title, "Building types" %>

<div class="max-w-6xl mx-auto px-6 py-16">
  <p class="text-xs font-semibold tracking-widest uppercase text-slate-500">Structured database</p>
  <h1 class="mt-2 text-3xl font-semibold text-slate-900">Ministry standard building types</h1>
  <p class="mt-4 text-sm text-slate-600 max-w-2xl">
    Extracted from the Ministry's standard-designs documentation into a structured,
    comparable format. Anything not yet confirmed against a source PDF is flagged, not
    guessed.
  </p>

  <% @grouped.each do |category, building_types| %>
    <div class="mt-12">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
        <%= building_types.first.category_label %>
      </h2>
      <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% building_types.each do |bt| %>
          <%= link_to building_type_path(bt), class: "block border border-slate-300 p-5 hover:border-slate-900" do %>
            <span class="text-lg font-semibold text-slate-900 whitespace-nowrap">Type <%= bt.code %></span>
            <p class="mt-2 text-sm text-slate-600"><%= bt.name %></p>
            <div class="mt-3"><%= render "status_badge", building_type: bt %></div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
