                      <span style="display:flex;align-items:center;padding-right:12px;font:400 11px/1 'IBM Plex Mono',monospace;color:#8A8189;text-transform:uppercase;letter-spacing:0.08em">{{ f.unit }}</span>
                      <button sc-camel-on-click="{{ f.onPlus }}" style="width:42px;border:none;border-left:1px solid #D7DAD7;background:transparent;font-size:18px;line-height:1" style-hover="background:#F1F3F2">+</button>
                    </div>
                  </sc-if>

                  <sc-if value="{{ f.isChoice }}" hint-placeholder-val="{{ true }}">
                    <div style="display:flex;flex-wrap:wrap;gap:8px">
                      <sc-for list="{{ f.options }}" as="o" hint-placeholder-count="3">
                        <button sc-camel-on-click="{{ o.onClick }}" style="{{ o.style }}">{{ o.label }}</button>
                      </sc-for>
                    </div>
                  </sc-if>

                  <sc-if value="{{ f.isText }}" hint-placeholder-val="{{ true }}">
                    <input type="text" value="{{ f.value }}" sc-camel-on-change="{{ f.onChange }}" placeholder="{{ f.placeholder }}" style="width:100%;max-width:420px;border:1px solid #2C112D;background:#fff;padding:13px 14px;font-size:15px;color:#2C112D">
                  </sc-if>

                  <sc-if value="{{ f.isTextarea }}" hint-placeholder-val="{{ true }}">
                    <textarea value="{{ f.value }}" sc-camel-on-change="{{ f.onChange }}" placeholder="{{ f.placeholder }}" rows="4" style="width:100%;border:1px solid #2C112D;background:#fff;padding:13px 14px;font-size:15px;line-height:1.5;color:#2C112D;resize:vertical"></textarea>
                  </sc-if>

                  <sc-if value="{{ f.note }}" hint-placeholder-val="{{ false }}">
                    <div style="display:flex;gap:10px;background:#EAEDEA;border-left:2px solid #2C112D;padding:12px 14px;font-size:13px;line-height:1.5;color:#5D5360;max-width:52em">{{ f.note }}</div>
                  </sc-if>
                </div>
              </sc-for>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
              <button sc-camel-on-click="{{ onPrevSection }}" style="background:transparent;border:1px solid #2C112D;color:#2C112D;padding:15px 22px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#E4E0E2">← Back</button>
              <button sc-camel-on-click="{{ onNextSection }}" style="background:#2C112D;border:1px solid #2C112D;color:#fff;padding:15px 24px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#46203F">{{ nextLabel }} →</button>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isReview }}" hint-placeholder-val="{{ true }}">
        <div data-screen-label="Review requirements" style="flex:1;position:relative;z-index:1;padding:0 clamp(22px,4vw,56px) clamp(26px,4vw,52px);background:{{ reviewBg }}">
          <div style="max-width:1180px;margin:0 auto">
            <div style="display:flex;margin:0 0 26px;margin-left:calc(-1 * clamp(22px,4vw,56px))">
