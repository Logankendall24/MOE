                  </div>
                  <div style="padding:6px 18px 14px">
                    <sc-for list="{{ g.rows }}" as="r" hint-placeholder-count="3">
                      <div style="display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid #EDEFEC;font-size:14px">
                        <span style="color:#5D5360">{{ r.label }}</span>
                        <span style="font:500 14px/1.3 'IBM Plex Mono',monospace;text-align:right">{{ r.value }}</span>
                      </div>
                    </sc-for>
                  </div>
                </div>
              </sc-for>

              <div style="background:#2C112D;color:#fff;border:1px solid #2C112D">
                <div style="padding:14px 18px;border-bottom:1px solid rgba(255,255,255,0.22);font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase">Requirement calculation</div>
                <div style="padding:6px 18px 16px">
                  <sc-for list="{{ calcRows }}" as="r" hint-placeholder-count="5">
                    <div style="display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,0.14);font-size:14px">
                      <span style="color:rgba(255,255,255,0.7)">{{ r.label }}</span>
                      <span style="font:500 14px/1.3 'IBM Plex Mono',monospace;text-align:right">{{ r.value }}</span>
                    </div>
                  </sc-for>
                  <sc-for list="{{ reqNotes }}" as="n" hint-placeholder-count="0">
                    <div style="margin-top:14px;font-size:12.5px;line-height:1.5;color:rgba(255,255,255,0.62);border-left:2px solid rgba(255,255,255,0.35);padding-left:10px">{{ n }}</div>
                  </sc-for>
                </div>
              </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
              <button sc-camel-on-click="{{ onBackToReq }}" style="background:transparent;border:1px solid #2C112D;color:#2C112D;padding:15px 22px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#E4E0E2">← Amend requirements</button>
              <button sc-camel-on-click="{{ onCalculate }}" style="background:#2C112D;border:1px solid #2C112D;color:#fff;padding:15px 24px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#46203F">Find building options →</button>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isOptions }}" hint-placeholder-val="{{ true }}">
        <div data-screen-label="Building options" style="flex:1;position:relative;z-index:1;padding:clamp(26px,4vw,52px) clamp(22px,4vw,56px)">
          <div style="max-width:1320px;margin:0 auto">
            <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
              <div style="min-width:0">
                <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:#8A8189">Step 03</div>
                <h2 style="margin:14px 0 8px;font-size:clamp(26px,3vw,36px);font-weight:500;letter-spacing:-0.02em">{{ optionCount }} standard design options</h2>
                <p style="margin:0;font-size:16px;line-height:1.45;color:#5D5360;max-width:44em">{{ optionsIntro }}</p>
              </div>
              <button sc-camel-on-click="{{ onCompare }}" style="{{ compareBtnStyle }}">Compare selected ({{ compareCount }})</button>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:22px;margin-top:34px;align-items:start">
              <sc-for list="{{ optionCards }}" as="o" hint-placeholder-count="3">
                <div style="{{ o.cardStyle }}">
                  <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #D7DAD7">
                    <div style="display:flex;align-items:center;gap:12px">
                      <span style="font:500 13px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em">OPTION {{ o.id }}</span>
                      <span style="{{ o.tagStyle }}">{{ o.tag }}</span>
                    </div>
                    <span style="{{ o.fitStyle }}">{{ o.fitText }}</span>
                  </div>

                  <div ref="{{ cardBoxRef }}" style="position:relative;height:210px;background:#F7F8F6;border-bottom:1px solid #D7DAD7;overflow:hidden">
                    <div style="position:absolute;inset:0;perspective:2200px">
                      <div style="{{ o.stageStyle }}">
                        <div style="{{ o.sceneStyle }}">
                          <sc-for list="{{ o.faces }}" as="f" hint-placeholder-count="12">
                            <div style="{{ f.style }}"></div>
                          </sc-for>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div style="padding:18px">
                    <div style="font-size:18px;font-weight:500;line-height:1.25">{{ o.title }}</div>
                    <p style="margin:8px 0 0;font-size:14px;line-height:1.5;color:#5D5360">{{ o.summary }}</p>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#E4E6E3;margin-top:18px;border:1px solid #E4E6E3">
                      <sc-for list="{{ o.stats }}" as="s" hint-placeholder-count="4">
                        <div style="background:#fff;padding:11px 12px">
                          <div style="font:400 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;color:#8A8189">{{ s.label }}</div>
                          <div style="margin-top:6px;font:500 16px/1 'IBM Plex Mono',monospace">{{ s.value }}</div>
                        </div>
                      </sc-for>
                    </div>

                    <div style="margin-top:16px;display:grid;gap:7px">
                      <sc-for list="{{ o.characteristics }}" as="c" hint-placeholder-count="4">
                        <div style="display:flex;gap:10px;font-size:13.5px;line-height:1.4;color:#3F3542"><span style="color:#A79FA5">›</span>{{ c }}</div>
                      </sc-for>
                    </div>

                    <div style="display:flex;gap:8px;margin-top:20px;flex-wrap:wrap">
                      <button sc-camel-on-click="{{ o.onView }}" style="flex:1;min-width:150px;background:#2C112D;border:1px solid #2C112D;color:#fff;padding:14px 16px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase" style-hover="background:#46203F">View building →</button>
                      <button sc-camel-on-click="{{ o.onToggleCompare }}" style="{{ o.compareStyle }}">{{ o.compareLabel }}</button>
                    </div>
                  </div>
                </div>
              </sc-for>
            </div>

            <sc-if value="{{ noOptions }}" hint-placeholder-val="{{ false }}">
              <div style="margin-top:30px;background:#fff;border:1px solid #D7DAD7;padding:26px;max-width:46em">
                <div style="font-size:18px;font-weight:500">No new standard buildings required</div>
                <p style="margin:10px 0 0;font-size:15px;line-height:1.5;color:#5D5360">The existing teaching spaces retained already meet the calculated entitlement, and no library or administration work is in scope. Adjust the roll, retained spaces or scope to see options.</p>
              </div>
            </sc-if>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isBuilding }}" hint-placeholder-val="{{ true }}">
        <div data-screen-label="Building view" style="flex:1;position:relative;z-index:1;padding:clamp(24px,3.4vw,44px) clamp(22px,4vw,56px) clamp(36px,4vw,60px)">
          <div style="max-width:1320px;margin:0 auto">
            <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap">
              <div style="min-width:0">
                <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:#8A8189">Step 04 · {{ optLabel }}</div>
                <h2 style="margin:12px 0 0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(30px,3.6vw,50px);font-weight:800;line-height:1.04;letter-spacing:-0.028em;text-wrap:pretty">{{ infoBlockName }}</h2>
                <div style="margin-top:10px;font:400 12.5px/1.5 'IBM Plex Mono',monospace;color:#7E7480">{{ infoBlockMeta }}</div>
              </div>
              <div style="display:flex;gap:6px;flex-wrap:wrap">
                <sc-for list="{{ optionTabs }}" as="t" hint-placeholder-count="3">
                  <button sc-camel-on-click="{{ t.onClick }}" style="{{ t.style }}">{{ t.label }}</button>
                </sc-for>
              </div>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:20px;margin-top:24px;align-items:stretch">
              <div style="display:flex;flex-direction:column;height:clamp(460px,64vh,660px);background:#F7F8F6;border:1px solid #D7DAD7;min-width:0">
                <div style="display:flex;gap:6px;flex-wrap:wrap;padding:12px 14px;border-bottom:1px solid #D7DAD7;background:#fff">
                  <sc-for list="{{ viewButtons }}" as="v" hint-placeholder-count="5">
                    <button sc-camel-on-click="{{ v.onClick }}" style="{{ v.style }}">{{ v.label }}</button>
                  </sc-for>
                </div>
                <div style="position:relative;flex:1;min-height:0;overflow:hidden">
                  <div ref="{{ viewerRef }}" sc-camel-on-mouse-down="{{ onViewerDown }}" sc-camel-on-wheel="{{ onViewerWheel }}" style="{{ viewerStyle }}">
                    <div style="{{ stageStyle }}">
                      <div style="{{ sceneStyle }}">
                        <sc-for list="{{ faces }}" as="f" hint-placeholder-count="18">
                          <div style="{{ f.style }}" sc-camel-on-click="{{ f.onClick }}"><span style="{{ f.labelStyle }}">{{ f.label }}</span></div>
                        </sc-for>
                      </div>
                    </div>
                  </div>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:12px 20px;flex-wrap:wrap;padding:12px 14px;border-top:1px solid #D7DAD7;background:#fff">
                  <div style="min-width:0;flex:1 1 260px">
                    <div style="font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase;color:#8A8189">Space categories · click to hide</div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:9px">
                      <sc-for list="{{ legend }}" as="l" hint-placeholder-count="6">
                        <button sc-camel-on-click="{{ l.onClick }}" style="{{ l.style }}"><span style="{{ l.swatchStyle }}"></span>{{ l.label }}</button>
                      </sc-for>
                    </div>
                  </div>
                  <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;text-align:right">
                    <span style="font:400 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;color:#8A8189">ROTATE · DRAG &nbsp;|&nbsp; ZOOM · SCROLL</span>
                    <span style="font:500 10px/1 'IBM Plex Mono',monospace;color:#2C112D">{{ viewReadout }}</span>
                  </div>
                </div>
              </div>

              <div style="background:#2C112D;color:#fff;padding:clamp(22px,2.4vw,32px);display:flex;flex-direction:column;gap:22px;min-width:0">
                <div>
                  <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.6)">Building overview</div>
                  <div style="margin-top:12px;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(20px,1.8vw,25px);font-weight:700;line-height:1.18;letter-spacing:-0.01em">{{ optTitle }}</div>
                  <p style="margin:8px 0 0;font-size:14px;line-height:1.5;color:rgba(255,255,255,0.74);text-wrap:pretty">{{ optSummary }}</p>
                </div>
                <sc-if value="{{ multiBlock }}" hint-placeholder-val="{{ false }}">
                  <div style="display:flex;gap:6px;flex-wrap:wrap">
                    <sc-for list="{{ blockTabs }}" as="b" hint-placeholder-count="2">
                      <button sc-camel-on-click="{{ b.onClick }}" style="{{ b.style }}">{{ b.label }}</button>
                    </sc-for>
                  </div>
                </sc-if>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(128px,1fr));gap:1px;background:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.2)">
                  <sc-for list="{{ keyStats }}" as="k" hint-placeholder-count="6">
                    <div style="background:#2C112D;padding:13px 14px">
                      <div style="font:400 9.5px/1.2 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.6)">{{ k.label }}</div>
                      <div style="margin-top:8px;font:500 19px/1 'IBM Plex Mono',monospace">{{ k.value }}</div>
                    </div>
                  </sc-for>
                </div>
                <div style="display:grid;gap:8px">
                  <sc-for list="{{ keyChars }}" as="c" hint-placeholder-count="4">
                    <div style="display:flex;gap:10px;font-size:13.5px;line-height:1.45;color:rgba(255,255,255,0.86)"><span style="color:rgba(255,255,255,0.45)">›</span>{{ c }}</div>
                  </sc-for>
                </div>

                <sc-if value="{{ hasSelection }}" hint-placeholder-val="{{ false }}">
                  <div style="border-top:1px solid rgba(255,255,255,0.25);padding-top:18px">
                    <div style="display:flex;justify-content:space-between;gap:12px;align-items:center">
                      <div style="font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.65)">Selected module</div>
                      <button sc-camel-on-click="{{ onClearSelection }}" style="background:transparent;border:1px solid rgba(255,255,255,0.4);color:#fff;padding:5px 9px;font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase">Clear</button>
                    </div>
                    <div style="margin-top:10px;font-size:17px;font-weight:500;line-height:1.25">{{ selectionName }}</div>
                    <div style="margin-top:8px;font-size:13px;line-height:1.5;color:rgba(255,255,255,0.75)">{{ selectionNote }}</div>
                    <div style="margin-top:10px">
                      <sc-for list="{{ selectionRows }}" as="r" hint-placeholder-count="3">
                        <div style="display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.16);font-size:13px">
                          <span style="color:rgba(255,255,255,0.7)">{{ r.label }}</span>
                          <span style="font:500 13px/1.3 'IBM Plex Mono',monospace">{{ r.value }}</span>
                        </div>
                      </sc-for>
                    </div>
                    <button sc-camel-on-click="{{ onToggleIsolate }}" style="{{ isolateStyle }}">{{ isolateLabel }}</button>
                  </div>
                </sc-if>

                <div style="margin-top:auto;display:flex;gap:8px;flex-wrap:wrap">
                  <button sc-camel-on-click="{{ onBackToOptions }}" style="flex:1;min-width:130px;background:transparent;border:1px solid rgba(255,255,255,0.5);color:#fff;padding:14px 16px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase" style-hover="border-color:#fff">← Options</button>
                  <button sc-camel-on-click="{{ onCompare }}" style="flex:1;min-width:130px;background:#fff;border:1px solid #fff;color:#2C112D;padding:14px 16px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase" style-hover="background:#F1D9E6;border-color:#F1D9E6">Compare</button>
                </div>
              </div>
            </div>

            <div style="margin-top:clamp(36px,4vw,52px);border-top:1px solid #2C112D;padding-top:20px">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap">
                <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(22px,2.2vw,30px);font-weight:800;letter-spacing:-0.02em">Building information</h3>
                <div style="font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:#8A8189">{{ infoBlockMeta }}</div>
              </div>
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:0 36px;margin-top:12px">
                <sc-for list="{{ infoRows }}" as="r" hint-placeholder-count="12">
                  <div style="display:flex;justify-content:space-between;gap:14px;padding:11px 0;border-bottom:1px solid #E4E6E3;font-size:14px">
                    <span style="color:#5D5360">{{ r.label }}</span>
                    <span style="font:500 13.5px/1.35 'IBM Plex Mono',monospace;text-align:right">{{ r.value }}</span>
                  </div>
                </sc-for>
              </div>

              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:28px 36px;margin-top:32px;align-items:start">
                <div style="min-width:0">
                  <div style="font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:#8A8189">Module schedule</div>
                  <div style="margin-top:12px;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,200px),1fr));gap:6px">
                    <sc-for list="{{ schedule }}" as="m" hint-placeholder-count="4">
                      <button sc-camel-on-click="{{ m.onClick }}" style="{{ m.style }}">
                        <span style="display:flex;justify-content:space-between;gap:12px;align-items:baseline;width:100%">
                          <span style="font-size:13.5px;text-align:left">{{ m.name }}</span>
                          <span style="font:500 12px/1 'IBM Plex Mono',monospace;white-space:nowrap">× {{ m.count }}</span>
                        </span>
                        <span style="display:flex;justify-content:space-between;gap:12px;width:100%;margin-top:6px;font:400 10.5px/1 'IBM Plex Mono',monospace;color:#8A8189;letter-spacing:0.06em">
                          <span>{{ m.code }}</span><span>{{ m.dims }}</span>
                        </span>
                      </button>
                    </sc-for>
                  </div>
                </div>
                <sc-if value="{{ showFit }}" hint-placeholder-val="{{ true }}">
                  <div style="min-width:0">
                    <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
                      <div style="font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:#8A8189">How this option matches</div>
                      <div style="font:500 12px/1 'IBM Plex Mono',monospace">{{ fitSummary }}</div>
                    </div>
                    <div style="margin-top:12px;display:grid;gap:9px">
                      <sc-for list="{{ fitLines }}" as="l" hint-placeholder-count="5">
                        <div style="display:grid;gap:5px;padding-bottom:9px;border-bottom:1px solid #EDEFEC">
                          <div style="display:flex;justify-content:space-between;gap:12px;font-size:13px">
                            <span>{{ l.label }}</span>
                            <span style="font:500 12.5px/1 'IBM Plex Mono',monospace">{{ l.figures }}</span>
                          </div>
                          <div style="height:3px;background:#EDEFEC"><div style="{{ l.barStyle }}"></div></div>
                          <div style="font:400 10.5px/1.3 'IBM Plex Mono',monospace;letter-spacing:0.04em;color:#8A8189">{{ l.text }}</div>
                        </div>
                      </sc-for>
                    </div>
                  </div>
                </sc-if>
              </div>
            </div>

            <div style="margin-top:clamp(40px,4.4vw,60px)">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;border-bottom:1px solid #2C112D;padding-bottom:16px">
                <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(22px,2.2vw,30px);font-weight:800;letter-spacing:-0.02em">Further information</h3>
                <div style="font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:#8A8189">From the MOE standard designs documentation</div>
              </div>
              <sc-if value="{{ infoLoading }}" hint-placeholder-val="{{ false }}">
                <div style="padding:20px 6px;font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:#8A8189">Loading from the MOE documentation…</div>
              </sc-if>
              <sc-if value="{{ infoError }}" hint-placeholder-val="{{ false }}">
                <div style="padding:20px 6px;font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:#8A8189">The MOE documentation could not be loaded.</div>
              </sc-if>
              <sc-for list="{{ infoSections }}" as="sct" hint-placeholder-count="6">
                <div style="border-bottom:1px solid #D7DAD7;background:rgba(255,255,255,0.92)">
                  <button sc-camel-on-click="{{ sct.onToggle }}" style="display:grid;grid-template-columns:44px minmax(0,1fr) 28px;align-items:center;gap:14px;width:100%;text-align:left;background:transparent;border:none;padding:20px 6px;color:#2C112D;cursor:pointer" style-hover="background:#F7F6F7">
