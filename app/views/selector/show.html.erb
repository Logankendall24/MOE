// Which part of the building each cladding in options B and C covers: on a
// multi-storey building the ground floor is the lower storey and every floor
// above it the upper; a single storey is split into lower and upper wall.
const cladParts = (blk) => {
  const n = (blk && blk.storeys) || 1;
  if (n <= 1) return { upper: 'Upper wall', lower: 'Lower wall' };
  if (n === 2) return { upper: 'Upper storey (first floor)', lower: 'Lower storey (ground floor)' };
  return { upper: 'Upper storeys (first and second floors)', lower: 'Lower storey (ground floor)' };
};

// SPG schedule columns, in the SPG spreadsheet's order.
const SPG_AREAS = ['class', 'gym', 'library', 'admin', 'resource', 'hall'];
const SPG_COLS = [
  { key: 'roll', label: 'Target roll' }, { key: 'code', label: 'Code' }, { key: 'ts', label: 'TS' },
  { key: 'class', label: 'Class' }, { key: 'gym', label: 'Gym' }, { key: 'library', label: 'Library' },
  { key: 'admin', label: 'Admin' }, { key: 'resource', label: 'Resource' }, { key: 'hall', label: 'Hall' }
];
// Rows pasted from the SPG spreadsheet (tab separated). Uses the header row
// when it's included, otherwise the spreadsheet's column order; the school
// type / name cells and an "N.B." note above the table are picked up too.
function parseSpg(text) {
  const rows = String(text || '').split(/\r?\n/).map((l) => l.split('\t').map((c) => c.trim().replace(/^"|"$/g, '')));
  const norm = (h) => h.toLowerCase().replace(/[^a-z]/g, '');
  const names = { targetroll: 'roll', code: 'code', ts: 'ts', class: 'class', gym: 'gym', library: 'library', admin: 'admin', resource: 'resource', hall: 'hall',
    gross: 'gross', approxgrossclasslibraryadminresource: 'grossClar' };
  const hi = rows.findIndex((r) => r.some((c) => norm(c) === 'targetroll'));
  const keys = hi >= 0 ? rows[hi].map((c) => names[norm(c)] || null)
    : ['roll', 'code', 'ts', 'class', 'gym', 'library', 'admin', 'resource', 'hall', null, 'gross', null, 'grossClar'];
  const data = rows.slice(hi + 1).find((r) => r.filter((c) => /\d/.test(c)).length >= 3);
  if (!data) return null;
  const out = {};
  keys.forEach((k, i) => {
    const cell = data[i];
    if (!k || cell == null || cell === '') return;
    out[k] = k === 'code' ? cell : cell.replace(/\s*m[²2]\s*$/i, '').replace(/,/g, '');
  });
  if (hi > 0) {
    const above = rows.slice(0, hi).map((r) => r.filter(Boolean)).filter((r) => r.length);
    const note = above.flat().find((c) => /^N\.?\s*B\.?/i.test(c));
    const first = above.find((r) => !r.some((c) => /^N\.?\s*B\.?/i.test(c)));
    if (first) { out.schoolType = first[0]; if (first[1]) out.schoolName = first[1]; }
    if (note) out.note = note;
  }
  return Object.keys(out).length ? out : null;
}

