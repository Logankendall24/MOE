              <sc-for list="{{ howParas }}" as="hp" hint-placeholder-count="2">
                <p style="margin:11px 0 0;font-size:16px;line-height:1.55;color:rgba(255,255,255,0.86);text-wrap:pretty">{{ hp }}</p>
