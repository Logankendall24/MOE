                  <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(20px,2vw,26px);font-weight:800;letter-spacing:-0.02em"><span style="font:500 12px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;color:#8A8189;margin-right:12px">{{ ps.no }}</span>{{ ps.title }}</h3>
