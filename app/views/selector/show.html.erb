  <sc-if value="{{ lbOpen }}" hint-placeholder-val="{{ false }}">
    <div sc-camel-on-click="{{ lbOnBackdrop }}" style="position:fixed;inset:0;z-index:80;background:rgba(19,6,20,0.82);display:flex;align-items:center;justify-content:center;padding:clamp(10px,2.4vw,36px);animation:dcFade 0.25s ease both">
      <div style="width:min(1440px,100%);max-height:100%;display:flex;flex-direction:column;background:#fff;color:#2C112D;border:1px solid #2C112D;animation:dcRise 0.35s ease both">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding:18px 22px;border-bottom:1px solid #D7DAD7">
          <div style="display:flex;flex-direction:column;gap:7px;min-width:0">
            <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(18px,1.8vw,24px);font-weight:800;line-height:1.15;letter-spacing:-0.015em">{{ lbTitle }}</h3>
            <span style="font:400 11px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.04em;color:#8A8189">{{ lbMeta }}</span>
          </div>
          <div style="display:flex;gap:8px;flex:none">
            <button sc-camel-on-click="{{ lbOnZoom }}" style="background:transparent;border:1px solid #B6B0B4;color:#2C112D;padding:11px 14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase" style-hover="border-color:#2C112D">{{ lbZoomLabel }}</button>
            <button sc-camel-on-click="{{ lbOnClose }}" style="background:#2C112D;border:1px solid #2C112D;color:#fff;padding:11px 14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase">Close</button>
          </div>
        </div>
        <sc-if value="{{ lbHasTabs }}" hint-placeholder-val="{{ false }}">
          <div style="display:flex;flex-wrap:wrap;gap:8px;padding:12px 22px;border-bottom:1px solid #EDEFEC">
            <sc-for list="{{ lbTabs }}" as="lt" hint-placeholder-count="2">
              <button sc-camel-on-click="{{ lt.onClick }}" style="{{ lt.style }}">{{ lt.label }}</button>
            </sc-for>
          </div>
        </sc-if>
        <div style="flex:1;min-height:0;overflow:auto;background:#F7F6F7">
          <div role="img" aria-label="{{ lbTitle }}" sc-camel-on-click="{{ lbOnZoom }}" style="{{ lbImgStyle }}"></div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:14px 22px;border-top:1px solid #D7DAD7">
          <a href="{{ lbSourceUrl }}" target="_blank" rel="noopener" style="font:400 10.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;color:#8A8189;text-decoration:none" style-hover="color:#2C112D">Source · {{ lbSourceLabel }} ↗</a>
          <div style="display:flex;align-items:center;gap:10px">
            <button sc-camel-on-click="{{ lbOnPrev }}" style="{{ lbPrevStyle }}">← Previous</button>
            <span style="font:400 11px/1 'IBM Plex Mono',monospace;color:#8A8189">{{ lbCount }}</span>
            <button sc-camel-on-click="{{ lbOnNext }}" style="{{ lbNextStyle }}">Next →</button>
          </div>
        </div>
