                  <div role="img" aria-label="{{ hm.name }}" style="{{ hm.tileStyle }}"></div>
                  <div style="display:flex;flex-direction:column;gap:5px;min-width:0">
                    <span style="font-size:15px;font-weight:500;color:#fff">{{ hm.name }}</span>
                    <span style="font-size:14px;line-height:1.45;color:rgba(255,255,255,0.78)">{{ hm.text }}</span>
                    <span style="font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:rgba(255,255,255,0.58)">{{ hm.area }} · {{ hm.size }}</span>
                  </div>
                </div>
              </sc-for>
            </div>
            <sc-for list="{{ howExamples }}" as="he" hint-placeholder-count="2">
              <div style="margin-top:18px">
                <div role="img" aria-label="{{ he.caption }}" style="{{ he.tileStyle }}"></div>
                <p style="margin:10px 0 0;font-size:14px;line-height:1.45;color:rgba(255,255,255,0.86)">{{ he.caption }}</p>
                <sc-if value="{{ he.hasNote }}" hint-placeholder-val="{{ false }}">
                  <p style="margin:6px 0 0;font-size:13px;line-height:1.45;color:rgba(255,255,255,0.6)">{{ he.note }}</p>
                </sc-if>
              </div>
            </sc-for>
            <div style="margin-top:18px">
              <sc-for list="{{ howClosing }}" as="hc" hint-placeholder-count="2">
                <p style="margin:0 0 9px;font-size:14px;line-height:1.5;color:rgba(255,255,255,0.78)">{{ hc }}</p>
              </sc-for>
            </div>
          </sc-if>

          <sc-if value="{{ panelHasSource }}" hint-placeholder-val="{{ false }}">
            <a href="{{ panelSourceUrl }}" target="_blank" rel="noopener" style="display:block;margin-top:28px;font:400 10.5px/1.5 'IBM Plex Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.55);text-decoration:none" style-hover="color:#fff">Source · {{ panelSourceLabel }} ↗</a>
          </sc-if>
        </div>
      </div>
    </sc-if>
  </sc-if>

  <sc-if value="{{ lbOpen }}" hint-placeholder-val="{{ false }}">
    <div sc-camel-on-click="{{ lbOnBackdrop }}" style="position:fixed;inset:0;z-index:80;background:rgba(19,6,20,0.82);display:flex;align-items:center;justify-content:center;padding:clamp(10px,2.4vw,36px);animation:dcFade 0.25s ease both">
      <div style="width:min(1440px,100%);max-height:100%;display:flex;flex-direction:column;background:#fff;color:#2C112D;border:1px solid #2C112D;animation:dcRise 0.35s ease both">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding:18px 22px;border-bottom:1px solid #D7DAD7">
          <div style="display:flex;flex-direction:column;gap:7px;min-width:0">
            <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(18px,1.8vw,24px);font-weight:800;line-height:1.15;letter-spacing:-0.015em">{{ lbTitle }}</h3>
            <span style="font:400 11px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.04em;color:#8A8189">{{ lbMeta }}</span>
          </div>
          <div style="display:flex;gap:8px;flex:none">
            <button sc-camel-on-click="{{ lbOnZoom }}" style="background:transparent;border:1px solid #B6B0B4;color:#2C112D;padding:11px 14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase" style-hover="border-color:#2C112D">{{ lbZoomLabel }}</button>
            <button sc-camel-on-click="{{ lbOnClose }}" style="background:#2C112D;border:1px solid #2C112D;color:#fff;padding:11px 14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase">Close</button>
          </div>
        </div>
        <sc-if value="{{ lbHasTabs }}" hint-placeholder-val="{{ false }}">
          <div style="display:flex;flex-wrap:wrap;gap:8px;padding:12px 22px;border-bottom:1px solid #EDEFEC">
            <sc-for list="{{ lbTabs }}" as="lt" hint-placeholder-count="2">
              <button sc-camel-on-click="{{ lt.onClick }}" style="{{ lt.style }}">{{ lt.label }}</button>
            </sc-for>
          </div>
        </sc-if>
        <div style="flex:1;min-height:0;overflow:auto;background:#F7F6F7">
          <div role="img" aria-label="{{ lbTitle }}" sc-camel-on-click="{{ lbOnZoom }}" style="{{ lbImgStyle }}"></div>
        </div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:14px 22px;border-top:1px solid #D7DAD7">
          <a href="{{ lbSourceUrl }}" target="_blank" rel="noopener" style="font:400 10.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;color:#8A8189;text-decoration:none" style-hover="color:#2C112D">Source · {{ lbSourceLabel }} ↗</a>
          <div style="display:flex;align-items:center;gap:10px">
            <button sc-camel-on-click="{{ lbOnPrev }}" style="{{ lbPrevStyle }}">← Previous</button>
            <span style="font:400 11px/1 'IBM Plex Mono',monospace;color:#8A8189">{{ lbCount }}</span>
            <button sc-camel-on-click="{{ lbOnNext }}" style="{{ lbNextStyle }}">Next →</button>
          </div>
        </div>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ isQuiz }}" hint-placeholder-val="{{ false }}">
    <div data-screen-label="{{ qLabel }}" style="position:relative;min-height:100vh;background:#2C112D url(&quot;/design/1278eb3b-8e9a-4746-a147-8fbefabcff61.png&quot;) center center / cover no-repeat;color:#fff;display:flex;flex-direction:column;padding:clamp(24px,4vw,56px) clamp(28px,5vw,80px)">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap">
        <button sc-camel-on-click="{{ onHome }}" style="background:transparent;border:none;padding:0;display:block;cursor:pointer">
          <img src="/design/3c68cb50-2e72-4854-bf69-d4d6d8cb5418.png" alt="Ministry of Education" style="width:clamp(150px,14vw,210px);height:auto;display:block">
        </button>
        <div style="display:flex;align-items:center;gap:16px;padding-top:6px">
          <div style="font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.65)">Question {{ qNo }} of {{ qTotal }}</div>
          <div style="display:flex;gap:6px">
            <sc-for list="{{ qDots }}" as="d" hint-placeholder-count="5"><span style="{{ d.style }}"></span></sc-for>
          </div>
        </div>
      </div>

      <div style="flex:1;display:flex;flex-direction:column;justify-content:center;gap:0;padding:clamp(28px,5vw,64px) 0;max-width:1040px">
        <h2 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(30px,4.2vw,58px);font-weight:800;line-height:1.05;letter-spacing:-0.028em;text-wrap:pretty">{{ qTitle }}</h2>
        <p style="margin:16px 0 0;font-size:clamp(15px,1.5vw,19px);line-height:1.45;color:rgba(255,255,255,0.72);max-width:40em;text-wrap:pretty">{{ qIntro }}</p>

        <sc-if value="{{ qHasModes }}" hint-placeholder-val="{{ false }}">
          <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:clamp(24px,3vw,36px)">
            <sc-for list="{{ qModes }}" as="m" hint-placeholder-count="2"><button sc-camel-on-click="{{ m.onClick }}" style="{{ m.style }}">{{ m.label }}</button></sc-for>
          </div>
        </sc-if>

        <sc-if value="{{ qIsNumber }}" hint-placeholder-val="{{ false }}">
          <div style="margin-top:clamp(20px,2.6vw,30px);display:flex;align-items:stretch;width:fit-content;border:1px solid rgba(255,255,255,0.5);background:rgba(255,255,255,0.05)">
            <button sc-camel-on-click="{{ qOnMinus }}" style="width:58px;background:transparent;border:none;border-right:1px solid rgba(255,255,255,0.3);color:#fff;font-size:24px;line-height:1" style-hover="background:rgba(255,255,255,0.14)">−</button>
            <input type="number" value="{{ qValue }}" sc-camel-on-change="{{ qOnChange }}" style="width:150px;background:transparent;border:none;color:#fff;text-align:center;font:500 30px/1 'IBM Plex Mono',monospace;padding:16px 6px">
            <span style="display:flex;align-items:center;padding:0 18px 0 4px;font:400 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.6)">{{ qUnit }}</span>
            <button sc-camel-on-click="{{ qOnPlus }}" style="width:58px;background:transparent;border:none;border-left:1px solid rgba(255,255,255,0.3);color:#fff;font-size:24px;line-height:1" style-hover="background:rgba(255,255,255,0.14)">+</button>
          </div>
        </sc-if>

        <sc-if value="{{ qShowInlineNext }}" hint-placeholder-val="{{ false }}">
          <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:16px">
            <button sc-camel-on-click="{{ qOnInlineNext }}" style="background:#fff;border:1px solid #fff;color:#2C112D;padding:15px 24px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#F1D9E6;border-color:#F1D9E6">Next step ↓</button>
          </div>
        </sc-if>

        <sc-if value="{{ qIsCounters }}" hint-placeholder-val="{{ false }}">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:12px;margin-top:clamp(22px,3vw,34px);max-width:1000px">
            <sc-for list="{{ qCounters }}" as="c" hint-placeholder-count="5">
              <div style="{{ c.rowStyle }}">
                <div style="display:flex;flex-direction:column;gap:5px;min-width:0">
                  <span style="font-size:17px;font-weight:500;line-height:1.2">{{ c.label }}</span>
                  <span style="{{ c.noteStyle }}">{{ c.note }}</span>
                </div>
                <div style="display:flex;align-items:stretch;flex:none;border:1px solid rgba(255,255,255,0.4)">
                  <button sc-camel-on-click="{{ c.onMinus }}" style="width:40px;background:transparent;border:none;color:inherit;font-size:19px;line-height:1" style-hover="background:rgba(255,255,255,0.14)">−</button>
                  <span style="display:flex;align-items:center;justify-content:center;width:44px;font:500 18px/1 'IBM Plex Mono',monospace;border-left:1px solid rgba(255,255,255,0.28);border-right:1px solid rgba(255,255,255,0.28)">{{ c.count }}</span>
                  <button sc-camel-on-click="{{ c.onPlus }}" style="width:40px;background:transparent;border:none;color:inherit;font-size:19px;line-height:1" style-hover="background:rgba(255,255,255,0.14)">+</button>
                </div>
              </div>
            </sc-for>
          </div>
          <div style="margin-top:18px;font:500 11px/1.5 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,0.7)">{{ qAllocated }}</div>
        </sc-if>

        <sc-if value="{{ qIsText }}" hint-placeholder-val="{{ false }}">
          <input type="text" value="{{ qText }}" sc-camel-on-change="{{ qOnText }}" placeholder="School name, town or address" style="margin-top:clamp(20px,2.6vw,30px);width:100%;max-width:620px;background:transparent;border:none;border-bottom:1px solid rgba(255,255,255,0.5);color:#fff;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(20px,2.2vw,28px);font-weight:500;padding:12px 2px">
        </sc-if>

        <sc-if value="{{ qHasOptions }}" hint-placeholder-val="{{ true }}">
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr));gap:12px;margin-top:clamp(24px,3vw,38px);max-width:1000px">
            <sc-for list="{{ qOptions }}" as="o" hint-placeholder-count="4">
              <button sc-camel-on-click="{{ o.onClick }}" style="{{ o.style }}">
                <span style="font-size:clamp(16px,1.6vw,19px);font-weight:500;line-height:1.22">{{ o.label }}</span>
                <span style="{{ o.noteStyle }}">{{ o.note }}</span>
              </button>
            </sc-for>
          </div>
        </sc-if>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,0.22);padding-top:20px">
        <img src="/design/f5388e0e-54eb-4680-99dd-f9874eb8f26b.png" alt="New Zealand Government" style="width:clamp(130px,11vw,175px);height:auto;display:block">
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <button sc-camel-on-click="{{ qOnBack }}" style="background:transparent;border:1px solid rgba(255,255,255,0.45);color:#fff;padding:16px 22px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="border-color:#fff">← Back</button>
          <button sc-camel-on-click="{{ qOnNext }}" style="background:#fff;border:1px solid #fff;color:#2C112D;padding:16px 26px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#F1D9E6;border-color:#F1D9E6">{{ qNextLabel }} →</button>
        </div>
      </div>
    </div>
  </sc-if>

  <sc-if value="{{ inApp }}" hint-placeholder-val="{{ true }}">
    <div style="position:relative;display:flex;flex-direction:column;min-height:100vh;background:{{ appBg }}">
      {{ moeArrow }}

      <div style="position:sticky;top:0;z-index:40;background:#2C112D;color:#fff;display:flex;align-items:stretch;justify-content:space-between;gap:16px;flex-wrap:wrap">
        <button sc-camel-on-click="{{ onHome }}" style="display:flex;align-items:center;background:transparent;border:none;padding:0 clamp(18px,2.4vw,32px);height:76px;cursor:pointer" style-hover="opacity:0.82">
          <img src="/design/3c68cb50-2e72-4854-bf69-d4d6d8cb5418.png" alt="Te Tāhuhu o te Mātauranga — Ministry of Education" style="height:44px;width:auto;display:block">
        </button>
        <div style="display:flex;align-items:stretch;gap:clamp(4px,1.2vw,18px);overflow-x:auto;padding-right:clamp(10px,2vw,28px)">
          <sc-for list="{{ steps }}" as="s" hint-placeholder-count="4">
            <button sc-camel-on-click="{{ s.onClick }}" style="{{ s.style }}">
              <span style="display:flex;flex-direction:column;align-items:flex-end;text-align:right;font:400 14px/1.22 Helvetica,Arial,sans-serif;white-space:nowrap">
                <span>{{ s.reo }}</span>
                <span>{{ s.label }}</span>
              </span>
              <span style="{{ s.chevStyle }}"></span>
            </button>
          </sc-for>
        </div>
      </div>

      <sc-if value="{{ isReq }}" hint-placeholder-val="{{ true }}">
        <div data-screen-label="School requirements" style="flex:1;position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,260px) minmax(0,1fr);align-items:start">
          <div style="border-right:1px solid #D7DAD7;background:#EAEDEA;min-height:100%;padding:26px 0">
            <div style="padding:0 22px 18px;font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:#8A8189">Requirements</div>
            <sc-for list="{{ sections }}" as="s" hint-placeholder-count="7">
              <button sc-camel-on-click="{{ s.onClick }}" style="{{ s.style }}">
                <span style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;opacity:0.6">{{ s.n }}</span>
                <span style="font-size:14px">{{ s.title }}</span>
              </button>
            </sc-for>
            <div style="margin:22px;padding-top:18px;border-top:1px solid #D7DAD7;font-size:12px;line-height:1.5;color:#7E7480">Not every field applies to every school. Anything left blank is treated as not in scope.</div>
          </div>

          <div style="padding:clamp(26px,4vw,52px) clamp(22px,4vw,56px);max-width:860px">
            <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:#8A8189">Section {{ sectionNo }} of 7</div>
            <h2 style="margin:14px 0 8px;font-size:clamp(26px,3vw,36px);font-weight:500;letter-spacing:-0.02em">{{ sectionTitle }}</h2>
            <p style="margin:0;font-size:16px;line-height:1.45;color:#5D5360;max-width:46em">{{ sectionIntro }}</p>

            <div style="margin-top:34px;border-top:1px solid #2C112D">
              <sc-for list="{{ fields }}" as="f" hint-placeholder-count="4">
                <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:12px;padding:20px 0;border-bottom:1px solid #D7DAD7">
                  <div style="display:flex;justify-content:space-between;gap:20px;align-items:baseline;flex-wrap:wrap">
                    <div style="font-size:16px;font-weight:500">{{ f.label }}</div>
                    <div style="font:400 11px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.04em;color:#8A8189;text-align:right">{{ f.hint }}</div>
                  </div>

                  <sc-if value="{{ f.isNumber }}" hint-placeholder-val="{{ true }}">
                    <div style="display:flex;align-items:stretch;gap:0;width:fit-content;border:1px solid #2C112D;background:#fff">
