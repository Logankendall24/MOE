                  <div style="padding:18px">
                    <div style="font-size:18px;font-weight:500;line-height:1.25">{{ o.title }}</div>
                    <p style="margin:8px 0 0;font-size:14px;line-height:1.5;color:#5D5360">{{ o.summary }}</p>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#E4E6E3;margin-top:18px;border:1px solid #E4E6E3">
                      <sc-for list="{{ o.stats }}" as="s" hint-placeholder-count="4">
                        <div style="background:#fff;padding:11px 12px">
                          <div style="font:400 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;color:#8A8189">{{ s.label }}</div>
                          <div style="margin-top:6px;font:500 16px/1 'IBM Plex Mono',monospace">{{ s.value }}</div>
                        </div>
                      </sc-for>
