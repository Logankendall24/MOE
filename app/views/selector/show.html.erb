                </div>
                <p style="margin:8px 0 0;font-size:14.5px;line-height:1.5;color:#5D5360;max-width:52em">{{ ps.intro }}</p>
                <sc-if value="{{ ps.isSimple }}" hint-placeholder-val="{{ false }}">
