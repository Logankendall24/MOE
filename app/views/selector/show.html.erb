<style>
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#F1F3F2;color:#2C112D;font-family:'Instrument Sans',Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:#2C112D;text-decoration:underline;text-underline-offset:3px}
  a:hover{color:#7A3A5E}
  button{font-family:inherit;cursor:pointer}
  input,textarea,select{font-family:inherit}
  input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
  ::selection{background:#2C112D;color:#fff}
  @keyframes dcFade{from{opacity:0}to{opacity:1}}
  @keyframes dcRise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
  @keyframes dcSlide{from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:translateX(0)}}
  @keyframes dcChev{from{opacity:0;transform:translateY(45%)}to{opacity:1;transform:translateY(0)}}
  @keyframes dcWipe{from{opacity:0;transform:scale(1.06)}to{opacity:1;transform:scale(1)}}
</style>
</helmet>


<div style="min-height:100vh;display:flex;flex-direction:column;background:#F1F3F2">

  <sc-if value="{{ isCover }}" hint-placeholder-val="{{ true }}">
    <div data-screen-label="Cover" style="position:relative;min-height:100vh;background:#2C112D url(&quot;/design/1278eb3b-8e9a-4746-a147-8fbefabcff61.png&quot;) center center / cover no-repeat;color:#fff;display:flex;flex-direction:column;justify-content:space-between;gap:clamp(24px,4vw,48px);padding:clamp(28px,4.5vw,64px) clamp(28px,5vw,80px);animation:dcWipe 1.1s ease both">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:clamp(20px,4vw,48px);flex-wrap:wrap;animation:dcFade 0.9s ease 0.5s both">
        <img src="/design/3c68cb50-2e72-4854-bf69-d4d6d8cb5418.png" alt="Te Tāhuhu o te Mātauranga — Ministry of Education" style="width:clamp(190px,18vw,281px);height:auto;display:block">
        <div style="display:flex;align-items:flex-start;justify-content:flex-end;flex-wrap:wrap;gap:14px clamp(20px,2.8vw,48px);padding-top:clamp(14px,2vw,30px)">
          <sc-for list="{{ navTabs }}" as="t" hint-placeholder-count="5">
            <button sc-camel-on-click="{{ t.onClick }}" style="display:flex;align-items:center;gap:12px;background:transparent;border:none;padding:0;color:#fff;cursor:pointer;transition:opacity 160ms ease" style-hover="opacity:0.72">
              <span style="display:flex;flex-direction:column;align-items:flex-end;text-align:right;font:400 15px/1.2 Helvetica,Arial,sans-serif;white-space:nowrap">
                <span>{{ t.reo }}</span>
                <span>{{ t.label }}</span>
              </span>
              <span style="width:11px;height:11px;flex:none;border-right:1.3px solid #fff;border-bottom:1.3px solid #fff;transform:rotate(45deg);margin:-7px 4px 0 2px"></span>
            </button>
          </sc-for>
        </div>
      </div>

      <div style="max-width:100%;padding:clamp(12px,2vw,28px) 0">
        <h1 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(28px,5.4vw,84px);font-weight:800;line-height:1.02;letter-spacing:-0.032em;white-space:nowrap;animation:dcRise 0.9s ease 1.6s both">Great schools, great spaces</h1>
        <p style="margin:clamp(18px,2.4vw,30px) 0 0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(20px,2.3vw,32px);font-weight:700;line-height:1.22;letter-spacing:-0.015em;max-width:16em;animation:dcRise 0.9s ease 1.85s both">Standard designs for primary and intermediate schools</p>
        <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-top:clamp(28px,3.6vw,46px);animation:dcRise 0.9s ease 2.2s both">
          <button sc-camel-on-click="{{ onStart }}" style="background:#fff;color:#2C112D;border:1px solid #fff;padding:18px 28px;font:500 12px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#F1D9E6;border-color:#F1D9E6">Select building module here →</button>
        </div>
      </div>

      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
        <img src="/design/f5388e0e-54eb-4680-99dd-f9874eb8f26b.png" alt="Te Kāwanatanga o Aotearoa — New Zealand Government" style="width:clamp(150px,13vw,215px);height:auto;display:block;animation:dcFade 0.9s ease 0.95s both">
        <sc-if value="{{ showTeReo }}" hint-placeholder-val="{{ true }}">
          <div style="font-size:13px;line-height:1.5;max-width:30em;color:rgba(255,255,255,0.5);text-align:right;animation:dcFade 0.9s ease 2.5s both">He mea tārai e mātou te mātauranga kia rangatira ai, kia mana taurite ai ōna huanga</div>
        </sc-if>
      </div>
    </div>
    <sc-if value="{{ showPanel }}" hint-placeholder-val="{{ false }}">
      <div style="position:fixed;inset:0;z-index:60;background:rgba(19,6,20,0.7);display:flex;justify-content:flex-end">
        <div style="width:min(580px,100%);height:100%;overflow:auto;background:#2C112D;border-left:1px solid rgba(255,255,255,0.25);padding:clamp(26px,4vw,52px);animation:dcSlide 0.35s ease both">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:20px">
            <h3 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(26px,3vw,38px);font-weight:800;line-height:1.08;letter-spacing:-0.022em;color:#fff">{{ panelTitle }}</h3>
            <button sc-camel-on-click="{{ onClosePanel }}" style="flex:none;background:transparent;border:1px solid rgba(255,255,255,0.4);color:#fff;padding:11px 14px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase" style-hover="border-color:#fff">Close</button>
          </div>
          <sc-if value="{{ panelHasTabs }}" hint-placeholder-val="{{ false }}">
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:24px">
              <sc-for list="{{ panelTabs }}" as="pt" hint-placeholder-count="3">
                <button sc-camel-on-click="{{ pt.onClick }}" style="{{ pt.style }}">{{ pt.label }}</button>
              </sc-for>
            </div>
          </sc-if>
          <sc-if value="{{ panelLoading }}" hint-placeholder-val="{{ false }}">
            <div style="margin-top:26px;font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:rgba(255,255,255,0.55)">Loading from the standard designs catalogue…</div>
          </sc-if>
          <sc-if value="{{ panelError }}" hint-placeholder-val="{{ false }}">
            <div style="margin-top:26px;font:400 11.5px/1.4 'IBM Plex Mono',monospace;color:rgba(255,255,255,0.55)">The standard designs catalogue could not be loaded.</div>
          </sc-if>

          <sc-if value="{{ showAboutIntro }}" hint-placeholder-val="{{ false }}">
            <div style="margin-top:26px;border-top:1px solid rgba(255,255,255,0.2);padding-top:16px">
              <div style="font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.55)">{{ panelCategory }}</div>
              <sc-for list="{{ aboutParas }}" as="ap" hint-placeholder-count="3">
                <p style="margin:11px 0 0;font-size:16px;line-height:1.55;color:rgba(255,255,255,0.86);text-wrap:pretty">{{ ap }}</p>
              </sc-for>
            </div>
          </sc-if>

          <sc-for list="{{ panelBlocks }}" as="b" hint-placeholder-count="3">
            <div style="margin-top:26px;border-top:1px solid rgba(255,255,255,0.2);padding-top:16px">
              <div style="font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.55)">{{ b.label }}</div>
              <p style="margin:11px 0 0;font-size:16px;line-height:1.55;color:rgba(255,255,255,0.86);text-wrap:pretty">{{ b.text }}</p>
            </div>
          </sc-for>

          <sc-if value="{{ showAck }}" hint-placeholder-val="{{ false }}">
            <div style="margin-top:26px;border-top:1px solid rgba(255,255,255,0.2);padding-top:16px">
