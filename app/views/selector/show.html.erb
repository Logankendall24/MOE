const EXAMPLE = { ...DEFAULTS, schoolName: 'Kowhai Primary School', roll: 310, rollFuture: 420, tsExisting: 9, specialist: 1, siteArea: 'Tight', maxStoreys: 'No preference' };

class Component extends DCLogic {
  state = {
    ready: false, screen: 'cover', section: 0, input: { ...DEFAULTS }, qStep: 0, wz: { ...WZ_DEFAULT }, panel: null, panelTab: 'about', openInfo: [], cStep: 0, heating: 'default',
    optionId: null, blockId: null,
    rx: 57, rz: -36, zoom: 1, panX: 0, panY: 0, drag: null, vw: 640, vh: 520,
    bayId: null, zoneId: null, isolate: false, hiddenCats: [], level: 'all',
    aboutSection: 'A'
  };

  async componentDidMount() {
    const [D, R] = window.MOE_D ? [window.MOE_D, window.MOE_R] : await Promise.all([import('./moe-data.js'), import('./moe-rules.js')]);
    this.D = D; this.R = R;
    window.addEventListener('mousemove', this.onMove);
    window.addEventListener('mouseup', this.endDrag);
    window.addEventListener('keydown', this.onKey);
    window.addEventListener('scroll', this.onAboutScroll, { passive: true });
    this.setState({ ready: true });
  }
  componentWillUnmount() {
    window.removeEventListener('mousemove', this.onMove);
    window.removeEventListener('mouseup', this.endDrag);
    window.removeEventListener('keydown', this.onKey);
    window.removeEventListener('scroll', this.onAboutScroll);
  }

  // About page scroll-spy: whichever section's midpoint sits closest to the
  // viewport centre becomes the active one, and the sticky sub-nav highlights
  // that letter. Debounced with requestAnimationFrame.
  onAboutScroll = () => {
    if (this.state.screen !== 'about' || this._aboutScrollScheduled) return;
    this._aboutScrollScheduled = true;
    requestAnimationFrame(() => {
      this._aboutScrollScheduled = false;
      const nodes = document.querySelectorAll('[data-about-section]');
      if (!nodes.length) return;
      const centreY = window.innerHeight * 0.4;
      let best = null, bestDist = Infinity;
      nodes.forEach((n) => {
        const r = n.getBoundingClientRect();
        const mid = (r.top + r.bottom) / 2;
        const d = Math.abs(mid - centreY);
        if (d < bestDist) { bestDist = d; best = n.getAttribute('data-about-section'); }
      });
      if (best && best !== this.state.aboutSection) this.setState({ aboutSection: best });
    });
  };
  scrollToAbout = (key) => {
    const el = document.getElementById('about-' + key.toLowerCase());
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    this.setState({ aboutSection: key });
  };

  /* ---------- calculation (memoised on input) ---------- */
  calc() {
    if (!this.R) return null;
    const ratio = Number(this.props.spaceRatio) || 25;
    const key = JSON.stringify(this.state.input) + ratio;
    if (this._key !== key) {
      this._key = key;
      this._req = this.R.calcRequirements(this.state.input, ratio);
      this._options = this.R.buildOptions(this._req);
      this._index = {};
      this._options.forEach((o) => o.blocks.forEach((b) => b.levels.flat().forEach((bay) => { this._index[bay.id] = { bay, block: b, option: o }; })));
    }
    return { req: this._req, options: this._options };
  }

  // The buildings asked for, one options section each: teaching (S / D types),
  // library and admin layouts, then the gym and hall codes [guide §16–17].
  pickSections(req, options) {
    const out = [];
    if (options.length) out.push({ key: 'teaching', title: 'Teaching spaces' });
    if (req.libraryModules) out.push({ key: 'library', title: 'Library' });
    if (req.adminModules) out.push({ key: 'admin', title: 'Administration' });
    req.companions.forEach((c) => out.push({ key: c.kind, title: c.label, companion: c }));
    return out;
  }
  pickFor(key, req) {
    const p = this.state.picks || {};
    if (key === 'library') return p.library || req.libraryLayout.id;
    if (key === 'admin') return p.admin || req.adminLayout.id;
    const c = req.companions.find((x) => x.kind === key);
    return c && c.codes.includes(p[key]) ? p[key] : c ? c.codes[0] : null;
  }
  // The selected building from every section, assembled in section order.
  // Memoised so block and bay ids stay stable between renders.
  option() {
    const c = this.calc(); if (!c) return null;
    const { req, options } = c;
    const t = options.find((o) => o.id === this.state.optionId) || options[0] || null;
    const sections = this.pickSections(req, options);
    const key = this._key + '|' + (t ? t.id : '') + '|' + sections.map((sc) => sc.key + ':' + this.pickFor(sc.key, req)).join(',');
    if (this._selKey === key) return this._sel;
    const blocks = [...(t ? t.blocks : [])];
    sections.forEach((sc) => {
      if (sc.key === 'library') blocks.push(this.R.libraryBlock(req, this.pickFor('library', req)));
      else if (sc.key === 'admin') blocks.push(this.R.adminBlock(req, this.pickFor('admin', req)));
      else if (sc.companion) blocks.push(this.R.companionBlock(this.pickFor(sc.key, req)));
    });
    if (!blocks.length) { this._selKey = key; this._sel = null; return null; }
    blocks.forEach((b) => b.levels.flat().forEach((bay) => { this._index[bay.id] = { bay, block: b }; }));
    const { totals, fit } = this.R.assemble(blocks, req);
    this._selKey = key;
    this._sel = { id: t ? t.id : '', teaching: t, title: t ? t.title : 'Selected buildings', summary: t ? t.summary : '',
      characteristics: t ? t.characteristics : [], blocks, totals, fit };
    return this._sel;
  }
  block() {
    const o = this.option(); if (!o) return null;
    return o.blocks.find((b) => b.id === this.state.blockId) || o.blocks[0];
  }
  // The teaching building customisation applies to (cladding, layouts, heating).
  mainBlock(o) {
    return (o.teaching && o.teaching.blocks[0]) || o.blocks[0];
  }

  /* ---------- field handling ---------- */
  set(key, value) {
    // The school type also sets the category (modules, building types, documents).
    const cat = value === 'Primary' ? 'primary_intermediate' : 'secondary';
    const extra = key === 'schoolType' ? { category: cat, schoolTypeLabel: this.R ? this.R.SCHOOL_LABEL[cat] : value } : {};
    this.setState((s) => ({ input: { ...s.input, [key]: value, ...extra } }));
  }
  toggleChip(key, value) {
    this.setState((s) => {
      const cur = s.input[key] || [];
      const next = cur.includes(value) ? cur.filter((v) => v !== value) : [...cur, value];
      return { input: { ...s.input, [key]: next } };
    });
  }
  go(screen, extra = {}) { this.setState({ screen, ...extra }); window.scrollTo(0, 0); }

  // Direct entry: parse the building code(s) (see parseCodes in the rules) and
  // go straight to the building page with that building loaded.
  directEntry(code) {
    const d = this.R.parseCodes(code);
    if (d.error) return this.setState({ directError: d.error });
    const region = REGIONS.find((r) => r.label === this.state.directRegion);
    if (!region) return this.setState({ directError: 'Choose the school’s location — it sets the climate zone for heating and ventilation.' });
    const has = (kind) => (d.companions.some((c) => c.kind === kind) ? 'Yes' : 'No');
    const input = {
      ...DEFAULTS, category: d.category, direct: d,
      schoolType: d.category === 'secondary' ? 'Secondary / intermediate' : 'Primary',
      schoolTypeLabel: this.R.SCHOOL_LABEL[d.category], schoolName: '',
      roll: 0, rollFuture: 0, tsExisting: 0, specialist: 0, specialistTypes: [],
      library: 'No', admin: 'No', hall: has('hall'), gym: has('gym'),
      gymCourts: d.companions.some((c) => c.codes[0] === 'G4') ? '2' : '1',
      maxStoreys: 'No preference', climate: region.zone
    };
    const picks = {};
    d.companions.forEach((c) => { picks[c.kind] = c.codes[0]; });
    this.setState({ input, picks, screen: 'building', section: 0, optionId: null, blockId: null, bayId: null, directError: '',
      wz: { ...this.state.wz, region: region.label } }, () => window.scrollTo(0, 0));
  }

  directVals() {
    if (this.state.screen !== 'direct') return { directCode: '', directError: '', hasDirectError: false, directRegions: [], onDirectSubmit: () => {}, onDirectChange: () => {}, onDirectKey: () => {}, onDirectBack: () => {} };
    return {
      directCode: this.state.directCode || '',
      directError: this.state.directError || '',
      hasDirectError: !!(this.state.directError),
      directRegions: REGIONS.map((r) => {
        const on = this.state.directRegion === r.label;
        return { label: r.label, note: r.note + ' · zone ' + r.zone,
          style: this.qOpt(on).replace('padding:19px 20px', 'padding:12px 14px').replace('gap:7px', 'gap:4px'),
          noteStyle: this.qNote(on).replace('12px/1.4', '11px/1.35'),
          onClick: () => this.setState({ directRegion: r.label, directError: '' }) };
      }),
      onDirectSubmit: () => this.directEntry(this.state.directCode),
      onDirectChange: (e) => this.setState({ directCode: e.target.value, directError: '' }),
      onDirectKey: (e) => { if (e.key === 'Enter') this.directEntry(this.state.directCode); },
      onDirectBack: () => this.go('cover')
    };
  }

  /* ---------- MOE catalogue (served by Rails from db/catalogue) ---------- */
  // Which school category's documents to show. Before the requirements are
  // finished this follows the first quiz answer, so the cover's About panel
  // defaults to primary / intermediate.
  category() {
    const s = this.state;
    if (s.screen !== 'cover' && s.screen !== 'quiz' && s.input.category) return s.input.category;
    return s.wz.schoolType === 'Secondary / intermediate school' ? 'secondary' : 'primary_intermediate';
  }
  fetchJson(url) {
    this._cat = this._cat || {};
    if (this._cat[url]) return this._cat[url].data;
    this._cat[url] = { data: null };
    const done = (data) => { this._cat[url] = { data }; this.setState((st) => ({ catTick: (st.catTick || 0) + 1 })); };
    fetch(url, { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then(done, () => done({ error: true }));
    return null;
  }
  aboutData() { return this.fetchJson('/api/catalogue/about?category=' + this.category()); }
  // Everything the building page's Further information needs, filtered by the
  // selected building and the user's requirements (see app/services/layout_rules.rb).
  buildingData(blk, req) {
    const i = this.state.input;
    const q = new URLSearchParams({
      category: this.category(), type: blk.typeId, roll: String(i.rollFuture || ''),
      zone: String(req.climateZone || i.climate || '3'), layout: String(i.layout || '')
    });
    ['teaching', ...['library', 'admin', 'hall', 'gym'].filter((k) => i[k] === 'Yes')].forEach((b) => q.append('buildings[]', b));
    (i.specialist > 0 ? i.specialistTypes || [] : []).forEach((t) => q.append('specialists[]', t));
    return this.fetchJson('/api/catalogue/building?' + q.toString());
  }
  // 3D windows: the building's GLB (db/catalogue/models_3d.yml) replaces the
  // design's massing once it has loaded, on the building page (driven by the
  // same toolbar, key and readout) and on each option card (rotate only, so
  // the page still scrolls). Until then, or if the browser can't show it, the
  // massing stays. Each window is a "slot" with its own viewer.
  modelSlot(key, url, opts) {
    this._slots = this._slots || {};
    let slot = this._slots[key];
    if (!slot) {
      slot = this._slots[key] = { el: null, mv: null, loading: null, want: null, opts };
      slot.ref = (el) => {
        if (el === slot.el) return;
        if (slot.mv) { slot.mv.dispose(); slot.mv = null; }
        slot.el = el; slot.loading = null;
        if (el) this.syncSlot(slot);
      };
    }
    slot.want = url && this.state.modelFailed !== url ? url : null;
    if (slot.want) queueMicrotask(() => this.syncSlot(slot));
    const ready = !!(slot.want && slot.mv && slot.mv.loadedUrl === slot.want);
    return { slot, ready, hasModel: !!slot.want,
      style: 'position:absolute;inset:0;cursor:grab;' + (ready ? '' : 'visibility:hidden;pointer-events:none;') };
  }
  syncSlot(slot) {
    const el = slot.el, url = slot.want;
    if (!el || !url || slot.loading === url) return;
    slot.loading = url;
    import('/viewer/model-viewer.js?v=' + (window.__viewerVersion || ''))
      .then(({ ModelViewer }) => {
        if (slot.el !== el) return null;
        slot.mv = slot.mv || new ModelViewer(el, { onChange: this.modelChanged, ...slot.opts });
        return slot.mv.load(url);
      })
      .then(() => this.setState((st) => ({ mvTick: (st.mvTick || 0) + 1 })))
      .catch((e) => { console.warn('3D model unavailable; showing the massing view.', e); this.setState({ modelFailed: url }); });
  }
  onModelPick = (info) => this.setState({ modelPick: info, modelIsolate: false });
  // The piece clicked in the 3D model, in the same side panel the massing's
  // module selection uses. The model's objects are unnamed, so the piece is
  // described by its material (mapped to the catalogue legend) and measured.
  modelSelectionVals(req) {
    const slot = (this._slots || {}).building;
    if (!slot || !slot.mv || slot.mv.loadedUrl !== slot.want) return {};
    const p = this.state.modelPick;
    if (!p) return { hasSelection: false };
    const label = this.spaceName('materials', p.material, p.material || 'Model piece');
    const M = this.D.MODULES;
    const ts = req.category === 'secondary' ? M.TS_S : M.TS_P;
    const standard = { 'General teaching space': `${ts.letter} module, ${ts.w} m × ${ts.d} m`, 'WC': 'Resource / admin / toilet bay (half or full)',
      'Admin & resource space': 'Resource / admin / toilet bay (half or full)' }[label];
    const on = !!this.state.modelIsolate;
    return {
      hasSelection: true, selectionName: label,
      selectionNote: `Picked in the 3D model — ${p.sameType} piece${p.sameType === 1 ? '' : 's'} of this type. Sizes are measured from the placeholder model, not taken from the Ministry drawings.`,
      selectionRows: [
        { label: 'Space type', value: label },
        ...(standard ? [{ label: 'Standard module', value: standard }] : []),
        { label: 'Size (model)', value: `${p.width} m × ${p.depth} m` },
        { label: 'Plan area (model)', value: `≈ ${p.area} m²` },
        { label: 'Height (model)', value: `${p.height} m` },
        { label: 'Level', value: p.levels > 1 ? `L${p.level + 1} of ${p.levels}` : 'L1' },
        { label: 'Model layer', value: p.material || '—' }
      ],
      onClearSelection: () => slot.mv.select(null),
      onToggleIsolate: () => { slot.mv.isolate(!on); this.setState({ modelIsolate: !on }); },
      isolateLabel: on ? 'Show the whole model' : 'Isolate this piece',
      isolateStyle: `margin-top:14px;width:100%;background:${on ? '#fff' : 'transparent'};color:${on ? INK : '#fff'};` +
        `border:1px solid ${on ? '#fff' : 'rgba(255,255,255,0.45)'};padding:12px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;`
    };
  }
  modelVals(blk, req) {
    const s = this.state;
    const data = this.buildingData(blk, req);
    const m = data && !data.error ? data.model3d : null;
    const { slot, ready, hasModel, style } = this.modelSlot('building', m && m.glb, { onPick: this.onModelPick });
    const base = { hasModel, showMassing: !ready, modelRef: slot.ref, modelStyle: style };
    if (!ready) return base;
    const mv = slot.mv;
    const hidden = s.modelHidden || [];
    const r = mv.readout();
    const go = (name) => () => { if (name === 'reset') { mv.setHidden([]); this.setState({ modelHidden: [] }); } mv.view(name); this.modelChanged(); };
    return {
      ...base,
      viewButtons: [['Axonometric', 'axonometric'], ['Plan', 'plan'], ['Elevation', 'elevation'], ['Reset', 'reset']]
        .map(([label, name]) => ({ label, onClick: go(name), style: this.btn(name !== 'reset' && mv.preset === name) })),
      legend: mv.materials.map((g) => {
        const off = hidden.includes(g.name);
        return {
          label: this.spaceName('materials', g.name, g.name),
          style: this.legendStyle(off),
          swatchStyle: `width:11px;height:11px;flex:none;background:${g.color};border:1px solid rgba(44,17,45,0.35);opacity:${off ? 0.3 : 1};`,
          onClick: () => {
            const next = off ? hidden.filter((x) => x !== g.name) : [...hidden, g.name];
            mv.setHidden(next); this.setState({ modelHidden: next });
          }
        };
      }),
      viewReadout: `${m.label} · AZ ${r.az}° · EL ${r.el}° · ${r.zoom}%`
    };
  }
  // An option card's 3D window: the model for the option's first building.
  cardModelVals(o) {
    const ab = this.aboutData();
    const models = ab && !ab.error ? ab.models3d || {} : {};
    const m = models[o.blocks[0].typeId] || models.default;
    const { slot, ready, hasModel, style } = this.modelSlot('card-' + o.id, m && m.glb, { rotateOnly: true });
    return { hasModel, showMassing: !ready, modelRef: slot.ref, modelStyle: style };
  }
  // Re-render the readout at most once a frame while a camera moves.
  modelChanged = () => {
    if (this._mvTick) return;
    this._mvTick = requestAnimationFrame(() => { this._mvTick = null; this.setState((st) => ({ mvTick: (st.mvTick || 0) + 1 })); });
  };
  openSheet(cards, index) { this.setState({ lb: { cards, i: index, page: 0, zoom: false } }); }
  moveSheet(delta) {
    this.setState((st) => {
      if (!st.lb) return null;
      const i = clamp(st.lb.i + delta, 0, st.lb.cards.length - 1);
      return { lb: { ...st.lb, i, page: 0, zoom: false } };
    });
  }
  onKey = (e) => {
    if (!this.state.lb) return;
    if (e.key === 'Escape') this.setState({ lb: null });
    if (e.key === 'ArrowRight') this.moveSheet(1);
    if (e.key === 'ArrowLeft') this.moveSheet(-1);
  };

  /* ---------- viewer interaction ---------- */
  onMove = (e) => {
    const d = this.state.drag; if (!d) return;
    const dx = e.clientX - d.x, dy = e.clientY - d.y;
    if (d.pan) this.setState({ panX: d.panX + dx, panY: d.panY + dy });
    else this.setState({ rz: d.rz + dx * 0.4, rx: clamp(d.rx - dy * 0.3, 0, 90) });
  };
  endDrag = () => { if (this.state.drag) this.setState({ drag: null }); };
  startDrag = (e) => {
    const s = this.state;
    this.setState({ drag: { x: e.clientX, y: e.clientY, rx: s.rx, rz: s.rz, panX: s.panX, panY: s.panY, pan: e.shiftKey || e.button === 1 } });
  };
  wheel = (e) => { this.setState((s) => ({ zoom: clamp(s.zoom * (e.deltaY > 0 ? 0.92 : 1.08), 0.35, 3.2) })); };
  pick = (bay, zone) => this.setState({ bayId: bay.id, zoneId: zone ? zone.id : null, blockId: (this._index[bay.id] || {}).block.id });

  /* ---------- style helpers ---------- */
  btn(active, opts = {}) {
    const pad = opts.pad || '9px 13px';
    return `background:${active ? INK : 'transparent'};color:${active ? '#fff' : INK};border:1px solid ${active ? INK : '#B6B0B4'};` +
      `padding:${pad};font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;white-space:nowrap;`;
  }
  darkBtn(state) {
    const op = state === 'current' ? 1 : state === 'done' ? 0.78 : 0.45;
    return 'display:flex;align-items:center;gap:13px;background:transparent;border:none;padding:0 clamp(8px,1.2vw,16px);height:76px;' +
      'color:#fff;opacity:' + op + ';transition:opacity 400ms ease;cursor:pointer;';
  }

  geometry(allBlocks, target, opts = {}) {
    // Gyms and halls have no module geometry.
    const blocks = allBlocks.filter((b) => b.levels.length);
    if (!blocks.length) return { faces: [], width: 1, depth: 1, sceneW: 1, sceneH: 1, mPx: 1, metres: 0, heightPx: 0 };
    const metres = blocks.reduce((s, b) => s + b.length, 0) + (blocks.length - 1) * 6;
    const mPx = clamp(target / Math.max(metres, 12), opts.minM || 3, opts.maxM || 15);
    const storeys = Math.max(...blocks.map((b) => b.storeys));
    const g = this.R.buildFaces(blocks, mPx, opts);
    return { ...g, mPx, metres, heightPx: storeys * this.R.GEOM.LEVEL_H * mPx };
  }
  // Scale that fits the projected axonometric inside a measured box.
  fitZoom(g, boxW, boxH, rx, rz) {
    const rzr = Math.abs(rz) * Math.PI / 180, rxr = Math.abs(rx) * Math.PI / 180;
    const pw = g.width * Math.abs(Math.cos(rzr)) + g.depth * Math.abs(Math.sin(rzr));
    const ph = (g.width * Math.abs(Math.sin(rzr)) + g.depth * Math.abs(Math.cos(rzr))) * Math.cos(rxr) + g.heightPx * Math.sin(rxr);
    return clamp(Math.min(boxW / Math.max(pw, 1), boxH / Math.max(ph, 1)), 0.12, 1.6);
  }
  stage(rx, rz, zoom, panX, panY) {
    return `position:absolute;left:50%;top:50%;transform-style:preserve-3d;transform:translate(${panX}px,${panY}px) scale(${zoom}) rotateX(${rx}deg) rotateZ(${rz}deg);`;
  }
  scene(g) {
    return `position:absolute;left:0;top:0;width:0;height:0;transform-style:preserve-3d;transform:translate3d(${-g.width / 2}px,${-g.depth / 2}px,${-(g.heightPx || 0) / 2}px);`;
  }
  viewerRef = (el) => {
    if (!el) return;
    if (this._vel !== el) {
      this._vel = el;
      if (this._ro) this._ro.disconnect();
      this._ro = new ResizeObserver(() => this.measure(el));
      this._ro.observe(el);
    }
    this.measure(el);
  };
  measure(el) {
    const vw = el.clientWidth, vh = el.clientHeight;
    if (!vw || !vh) return;
    if (this.state.vw !== vw || this.state.vh !== vh) this.setState({ vw, vh });
  }
  // Measured box for any diagram container, keyed so several can coexist.
  boxRef(key) {
    this._refs = this._refs || {}; this._boxRos = this._boxRos || {};
    if (!this._refs[key]) {
      this._refs[key] = (el) => {
        if (!el) return;
        if (this._boxRos[key] && this._boxRos[key].el !== el) { this._boxRos[key].ro.disconnect(); delete this._boxRos[key]; }
        if (!this._boxRos[key]) {
          const ro = new ResizeObserver(() => this.measureBox(key, el));
          ro.observe(el); this._boxRos[key] = { ro, el };
        }
        this.measureBox(key, el);
      };
    }
    return this._refs[key];
  }
  measureBox(key, el) {
    const w = el.clientWidth, h = el.clientHeight;
    if (!w || !h) return;
    const cur = (this.state.boxes || {})[key];
    if (cur && cur.w === w && cur.h === h) return;
    this.setState((s) => ({ boxes: { ...(s.boxes || {}), [key]: { w, h } } }));
  }
  box(key, dw, dh) { return (this.state.boxes || {})[key] || { w: dw, h: dh }; }

  docItem(d) {
    const has = !!d.src;
    return {
      title: d.title, href: d.src || '#', status: has ? 'PDF · open document' : 'PDF to be added',
      onClick: has ? () => {} : (e) => e.preventDefault(),
      hasThumb: !!d.thumb, noThumb: !d.thumb, thumb: d.thumb || '',
      boxStyle: 'aspect-ratio:4 / 3;display:flex;align-items:center;justify-content:center;overflow:hidden;' +
        (has ? 'border:1px solid #D7DAD7;' : 'border:1px dashed #B6B0B4;') +
        (d.thumb ? "background:#fff url('" + d.thumb + "') center / cover no-repeat;" : 'background:' + (has ? '#fff' : '#FBFAFB') + ';')
    };
  }
  // Catalogue PDF pages (from the Rails API) as docItem boxes. Each page is
  // shown whole rather than cropped, and clicking it enlarges it in the
  // on-screen viewer (which still links to the PDF page), stepping through
  // the pages in the same list.
  pageDocs(list) {
    const cards = list.map((d) => ({ title: d.title, occupancy: '', module: '',
      pages: [{ page: d.page, sheet: d.sheet, thumb: d.thumb, full: d.full }], source: { title: d.sourceTitle, url: d.src } }));
    return list.map((d, i) => {
      const doc = this.docItem({ title: d.title, src: d.src, thumb: d.thumb });
      return { ...doc, boxStyle: doc.boxStyle.replace('/ cover', '/ contain') + 'cursor:zoom-in;',
        status: d.sheet ? 'Sheet ' + d.sheet : 'PDF · p.' + d.page,
        onClick: (e) => { e.preventDefault(); this.openSheet(cards, i); } };
    });
  }
  pageRef(d) { return d.sheet ? d.title + ' · ' + d.sheet : d.title + ' · p.' + d.page; }
  // A space-category key entry, in the page's body font.
  legendStyle(off) {
    return 'display:flex;align-items:center;gap:7px;background:transparent;border:none;padding:0;cursor:pointer;' +
      "font:500 13px/1.3 'Instrument Sans',Helvetica,Arial,sans-serif;color:" + (off ? '#B6B0B4' : '#3F3542') + ';text-decoration:' + (off ? 'line-through' : 'none') + ';';
  }
  // Specialist options for the requirements flow: every specialist space in
  // the category's layout PDFs, from the catalogue. Where the PDFs have none
  // (primary / intermediate) the design's own list is kept.
  specOpts() {
    const ab = this.aboutData();
    const list = ab && !ab.error ? ab.specialistSpaces : null;
    return list && list.length ? list : SPEC_OPTS;
  }
  // A space category's name as the catalogue legends print it (group: 'design'
  // for the massing categories, 'materials' for GLB layers), else the fallback.
  spaceName(group, key, fallback) {
    const ab = this.aboutData();
    return (ab && !ab.error && ab.spaceNames[group] && ab.spaceNames[group][key]) || fallback;
  }

  /* ---------- MOE graphics2 p5 arrow ---------- */
  arrowEl(key, side) {
    const h = React.createElement, N = 10;
    const chevs = Array.from({ length: N }, (_, k) => {
      const bars = Array.from({ length: 13 }, (_, i) => h('span', { key: i, style: {
        position: 'absolute', left: (i * 7.72) + '%', top: (Math.abs(i - 6) * 9.5) + '%',
        width: '3.9%', height: '43%', borderRadius: 99, background: INK } }));
      return h('div', { key: k, style: {
        position: 'relative', width: '100%', aspectRatio: '108 / 80', marginTop: k ? '-3.7%' : 0,
        animation: 'dcChev 950ms cubic-bezier(.2,.7,.2,1) ' + (300 + (N - 1 - k) * 120) + 'ms both' } },
        h('div', { style: { position: 'absolute', inset: 0, opacity: 0.03 + 0.12 * (k / (N - 1)) } }, bars));
    });
    return h('div', { key, 'aria-hidden': true, 'data-noprint': '', style: {
      position: 'fixed', [side]: 'clamp(12px,1.8vw,36px)', top: '26vh', width: 'clamp(40px,4.6vw,76px)',
      zIndex: 0, pointerEvents: 'none', display: 'flex', flexDirection: 'column' } }, chevs);
  }
  // Thin chevron. Rotation steps clockwise in 90° increments: 225 up · 315 right · 405 down.
  chev(deg, colour, size) {
    return 'display:block;flex:none;width:' + size + 'px;height:' + size + 'px;border-right:1.3px solid ' + colour + ';border-bottom:1.3px solid ' + colour + ';' +
      'transform:rotate(' + deg + 'deg);transition:transform 700ms cubic-bezier(.3,.7,.2,1),opacity 400ms ease;';
  }

  // Ticked layout sheets: the user's ticks, or the sheet matching the
  // design's current teaching layout letter until they tick something.
  tickedLayouts(sheets, req) {
    return this.state.layoutSheets || sheets.filter((d) => d.variant === req.layout.id).map((d) => d.id);
  }

  // Customise steps from the catalogue: the choices on the left, the chosen
  // option's PDF text and diagram on the right. Returns null for a step the
  // catalogue has nothing for (the design's own options are shown instead).
  customSplit(cs, cat, req, card, blk) {
    const s = this.state;
    const blank = { groups: [], hasTick: false, hasThumb: false, hasColours: false, hasFree: false, hasLink: false, colours: [], tag: '', note: '',
      tickMark: '', tickStyle: '', thumbStyle: '', colourLabel: '', colourLabelStyle: '', freeValue: '', freePlaceholder: '', inputStyle: '', linkUrl: '', linkLabel: '', linkStyle: '' };
    const detail = (d) => ({ cdKicker: '', cdTitle: '', cdHasImage: false, cdImageStyle: '', cdOnImage: () => {}, cdHasText: false, cdText: '',
      cdParas: [], cdBullets: [], cdHasNote: false, cdNote: '', cdHasSource: false, cdSourceLabel: '', cdSourceUrl: '', ...d });
    const source = (r) => (r ? { cdHasSource: true, cdSourceLabel: `${r.title} · p.${r.page}`, cdSourceUrl: r.url } : {});
    const image = (im, title) => (im ? { cdHasImage: true, cdOnImage: () => this.openSheet(this.cropCards([im], () => title), 0),
      cdImageStyle: `display:block;width:100%;padding:0;border:1px solid #EDEFEC;cursor:zoom-in;aspect-ratio:${im.aspect};background:#fff url('${im.src}') center / contain no-repeat;` } : {});
    const mono = (on) => `font:500 10px/1.3 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;color:${on ? 'rgba(255,255,255,0.75)' : '#8A8189'};`;
    const link = (on) => `display:inline-block;margin-top:12px;font:500 10.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;text-decoration:none;color:${on ? '#fff' : INK};`;

    // Heating and ventilation: the three options for the school's zone group.
    if (cs.id === 'heating' && cat.heating) {
      const h = cat.heating;
      const cur = h.options.find((o) => o.id === s.heating) || h.options[0];
      return {
        choices: h.options.map((o) => ({ ...blank, tag: `NZBC climate zones ${h.zones}`, label: o.name, note: o.text,
          style: card(o === cur), onClick: () => this.setState({ heating: o.id }) })),
        detail: detail({ cdKicker: `Heating & ventilation · site zone ${req.climateZone}`, cdTitle: cur.name, cdHasText: true, cdText: cur.text,
          cdParas: cur.paragraphs, ...image({ ...cur, page: h.source.page, source: h.source }, cur.name), ...source(h.source) })
      };
    }

    // Cladding: option A is profiled metal throughout. Options B and C pair
    // profiled metal on the upper storey (option A's colours) with brick or
    // painted fibre cement on the lower storey, each with its own colour.
    if (cs.id === 'cladding' && cat.cladding) {
      const c = cat.cladding;
      const chosen = s.cladColour || {};
      const cur = c.options.find((o) => o.id === req.cladding) || c.options[0];
      const metal = c.options.find((o) => o.id === 'A') || c.options[0];
      // Colour keys: 'A', 'B' / 'C' (lower storey) and 'B.upper' / 'C.upper'.
      const pick = (o, key, name) => { if (req.cladding !== o.id) this.set('cladding', o.id); this.setState((st) => ({ cladColour: { ...(st.cladColour || {}), [key]: name } })); };
      const colourOf = (src, key) => src.colours.find((col) => col.name === chosen[key]);
      const curColour = colourOf(cur, cur.id);
      const group = (o, on, src, key, heading) => {
        const col = colourOf(src, key);
        return { heading, hasHeading: !!heading, headingStyle: `font:600 13px/1.3 'Instrument Sans',Helvetica,Arial,sans-serif;color:${on ? '#fff' : INK};`,
          colourLabel: chosen[key] ? `Colour · ${chosen[key]}` : src.free ? 'Colour · enter a Resene colour name' : `Choose a colour · ${src.supplier}`, colourLabelStyle: mono(on),
          hasColours: src.colours.length > 0,
          colours: src.colours.map((cl) => ({ title: cl.name + (cl.check ? ` (to confirm: ${cl.check})` : ''), onClick: () => pick(o, key, cl.name),
            style: `width:30px;height:30px;padding:0;border-radius:50%;cursor:pointer;background:${cl.swatch};` +
              `border:2px solid ${chosen[key] === cl.name ? (on ? '#fff' : INK) : 'transparent'};box-shadow:0 0 0 1px rgba(0,0,0,0.18);` })),
          hasFree: !!src.free, freeValue: src.free ? chosen[key] || '' : '', freePlaceholder: 'e.g. a colour from the Resene colour library',
          onFree: (e) => pick(o, key, e.target.value),
          inputStyle: `width:100%;background:transparent;border:none;border-bottom:1px solid ${on ? 'rgba(255,255,255,0.6)' : '#B6B0B4'};color:inherit;padding:8px 0;font:400 15px/1.3 'Instrument Sans',Helvetica,Arial,sans-serif;outline:none;`,
          hasLink: !!src.supplierUrl, linkUrl: col && col.url ? col.url : src.supplierUrl,
          linkLabel: col ? `${col.name} on ${src.supplier}` : `${src.supplier} colours`, linkStyle: link(on) };
      };
      return {
        choices: c.options.map((o) => {
          const on = o === cur;
          const lower = o.id === 'B' ? 'brick' : 'painted fibre cement';
          const groups = o.id === metal.id ? [group(o, on, o, o.id, '')]
            : [group(o, on, metal, o.id + '.upper', cladParts(blk).upper + ' cladding — profiled metal'),
              group(o, on, o, o.id, cladParts(blk).lower + ' cladding — ' + lower)];
          return { ...blank, tag: o.id === metal.id ? `Colours · ${o.supplier}` : 'Upper and lower storey', label: o.name, note: '', style: card(on),
            onClick: () => this.set('cladding', o.id), groups };
        }),
        detail: detail({ cdKicker: 'Cladding' + (chosen[cur.id] ? ` · ${chosen[cur.id]}` : ''), cdTitle: cur.name, cdBullets: cur.bullets,
          ...image(cur.render, cur.render ? `${cur.name} · example render` : ''),
          cdHasNote: cur.colours.length > 0, cdNote: c.namesNote + (curColour && curColour.check ? ` ${curColour.name}: ${curColour.check}.` : ''),
          ...source(c.source) })
      };
    }

    // Teaching space layout: tick each standard layout sheet the school wants.
    if (cs.id === 'layout') {
      const sheets = (cat.customise.layout || []).filter((d) => d.id);
      if (!sheets.length) return null;
      const ticked = this.tickedLayouts(sheets, req);
      const docs = this.pageDocs(sheets);
      const focus = sheets.find((d) => d.id === s.layoutFocus) || sheets.find((d) => ticked.includes(d.id)) || sheets[0];
      const toggle = (d) => {
        const next = ticked.includes(d.id) ? ticked.filter((x) => x !== d.id) : [...ticked, d.id];
        this.setState({ layoutSheets: next, layoutFocus: d.id });
        // Keep the design's layout letter (used by the massing view) on the first ticked sheet.
        const first = sheets.find((x) => next.includes(x.id));
        if (first && first.variant && this.D.TEACHING_LAYOUTS[first.variant]) this.set('layout', first.variant);
      };
      return {
        choices: sheets.map((d) => {
          const on = ticked.includes(d.id);
          return { ...blank, hasTick: true, tickMark: on ? '✓' : '', hasThumb: true, tag: d.sheet, label: d.title.replace(/^Layouts - /, ''),
            note: on ? 'Ticked' : 'Tick to include', style: card(on), onClick: () => toggle(d),
            tickStyle: `display:flex;align-items:center;justify-content:center;flex:none;width:24px;height:24px;border:1.5px solid ${on ? '#fff' : INK};font:600 15px/1 'Instrument Sans',sans-serif;`,
            thumbStyle: `display:block;flex:none;width:112px;aspect-ratio:1.4142;border:1px solid #EDEFEC;background:#fff url('${d.thumb}') center / contain no-repeat;` };
        }),
        detail: detail({ cdKicker: `Layout sheet · ${focus.sheet}`, cdTitle: focus.title.replace(/^Layouts - /, ''),
          cdHasImage: true, cdOnImage: docs[sheets.indexOf(focus)].onClick,
          cdImageStyle: `display:block;width:100%;padding:0;border:1px solid #EDEFEC;cursor:zoom-in;aspect-ratio:1.4142;background:#fff url('${focus.thumb}') center / contain no-repeat;`,
          cdParas: [`${ticked.length} of ${sheets.length} standard layouts ticked for this building type.`],
          cdHasSource: true, cdSourceLabel: `${focus.sourceTitle} · p.${focus.page}`, cdSourceUrl: focus.src })
      };
    }
    return null;
  }

  /* ---------- SPG schedule ---------- */
  // The Ministry's SPG numbers: the school's area schedule, entered or pasted
  // from the SPG spreadsheet so it goes into the same PDF. Net and the class /
  // library / admin / resource subtotal are sums; gross is net × the gross
  // factor (1.3 in the SPG sample) unless a pasted row gives it.
  spgVals(req) {
    const v = this.state.spg || {};
    const num = (k) => { const n = parseFloat(String(v[k] == null ? '' : v[k]).replace(/[^0-9.\-]/g, '')); return isFinite(n) ? n : 0; };
    const factor = num('factor') || 1.3;
    const sum = (keys) => keys.reduce((t, k) => t + num(k), 0);
    const net = sum(SPG_AREAS), clar = sum(['class', 'library', 'admin', 'resource']);
    const gross = v.gross ? num('gross') : net * factor;
    const grossClar = v.grossClar ? num('grossClar') : clar * factor;
    const m2 = (n) => (n ? n0(n) + ' m²' : '—');
    const set = (k) => (e) => { const val = e.target.value; this.setState((st) => ({ spg: { ...(st.spg || {}), [k]: val, ...(SPG_AREAS.includes(k) ? { gross: '', grossClar: '' } : {}) } })); };
    const field = "width:100%;border:1px solid #B6B0B4;background:#fff;padding:10px 11px;font:500 14px/1.2 'IBM Plex Mono',monospace;color:#2C112D;";
    const filled = SPG_COLS.some((c) => String(v[c.key] || '').trim()) || !!(v.schoolType || v.schoolName);
    const text = (k) => String(v[k] == null ? '' : v[k]);
    return {
      spgHint: `This tool’s own calculation, for reference: a roll of ${n0(req.roll)} and ${req.tsEntitlement} teaching spaces.`,
      spgInfo: [
        { label: 'School type', value: text('schoolType'), placeholder: 'e.g. Contributing Primary (Y1-6)', onChange: set('schoolType'), style: field },
        { label: 'School', value: text('schoolName'), placeholder: 'School name', onChange: set('schoolName'), style: field },
        { label: 'Note', value: text('note'), placeholder: 'e.g. N.B. this calculation is NOT for Māori Medium', onChange: set('note'), style: field }
      ],
      spgInputs: [...SPG_COLS, { key: 'factor', label: 'Gross factor' }].map((c) => ({
        label: c.label + (SPG_AREAS.includes(c.key) ? ' · m²' : ''), value: text(c.key), onChange: set(c.key), style: field,
        placeholder: c.key === 'factor' ? '1.3' : c.key === 'code' ? 'e.g. 750 No Contributing' : '0' })),
      spgComputed: [
        { label: 'Net', value: m2(net) },
        { label: v.gross ? 'Gross (as pasted)' : `Gross (net × ${factor})`, value: m2(gross) },
        { label: 'Net class / library / admin / resource', value: m2(clar) },
        { label: v.grossClar ? 'Approx. gross class / library / admin / resource (as pasted)' : 'Approx. gross class / library / admin / resource', value: m2(grossClar) }
      ],
      spgFilled: filled, spgEmpty: !filled,
      spgSchool: [text('schoolType'), text('schoolName')].filter(Boolean).join(' · '),
      spgNote: text('note'), spgHasNote: !!text('note'),
      spgHead: ['Target roll', 'Code', 'TS', 'Class', 'Gym', 'Library', 'Admin', 'Resource', 'Hall', 'Net', 'Gross', 'Net class / library / admin / resource', 'Approx. gross class / library / admin / resource'],
      spgRow: [text('roll') || '—', text('code') || '—', text('ts') || '—', ...SPG_AREAS.map((k) => m2(num(k)).replace('—', '0 m²')), m2(net), m2(gross), m2(clar), m2(grossClar)],
      spgPaste: this.state.spgPaste || '', spgPasteNote: this.state.spgPasteNote || '',
      onSpgPaste: (e) => {
        const raw = e.target.value;
        const parsed = parseSpg(raw);
        if (!parsed) return this.setState({ spgPaste: raw, spgPasteNote: 'No SPG row found — copy the header row and the school’s row from the spreadsheet.' });
        this.setState((st) => ({ spgPaste: raw, spg: { ...(st.spg || {}), ...parsed },
          spgPasteNote: 'Imported ' + Object.keys(parsed).length + ' values. Check them below.' }));
      },
      onSpgClear: () => this.setState({ spg: {}, spgPaste: '', spgPasteNote: '' })
    };
  }

  /* ---------- customise building + PDF report ---------- */
  customVals(req, opt, blk) {
    const s = this.state, D = this.D;
    const step = clamp(s.cStep, 0, CUSTOM_STEPS.length - 1);
    const cs = CUSTOM_STEPS[step];
    const zone = CLIMATE_BAND(D, req.climateZone);
    const card = (active, extra) => 'display:flex;flex-direction:column;align-items:flex-start;gap:10px;text-align:left;width:100%;padding:20px 20px 22px;cursor:pointer;' +
      'border:1px solid ' + (active ? INK : '#D7DAD7') + ';background:' + (active ? INK : '#fff') + ';color:' + (active ? '#fff' : INK) + ';' +
      'box-shadow:' + (active ? '0 0 0 1px ' + INK : 'none') + ';transition:background 160ms ease,border-color 160ms ease;' + (extra || '');
    const sw = (fill) => fill ? 'display:block;width:100%;height:54px;margin-bottom:6px;border:1px solid rgba(0,0,0,0.12);background:' + fill + ';' : 'display:none;';
    // Catalogue data for the building: when loaded, the heating, cladding and
    // layout steps come from the PDFs (customSplit); the design's own options
    // are the fallback until then.
    const cat = ['building', 'customise', 'report'].includes(s.screen) ? this.buildingData(blk, req) : null;
    const catOk = !!(cat && !cat.error);
    const split = catOk ? this.customSplit(cs, cat, req, card, blk) : null;
    let options = [];
    if (split) { /* catalogue choices replace the design's option cards */ } else if (cs.id === 'cladding') options = Object.values(D.CLADDING).map((c) => ({ tag: 'Option ' + c.id, label: c.name.replace(/^Option . — /, ''), note: c.notes,
      style: card(req.cladding === c.id), swatchStyle: sw(c.wall), onClick: () => this.set('cladding', c.id) }));
    if (!split && cs.id === 'layout') options = Object.values(D.TEACHING_LAYOUTS).map((l) => ({ tag: 'Layout ' + l.id, label: l.name.replace(/^Layout . — /, ''), note: l.summary,
      style: card(req.layout.id === l.id), swatchStyle: sw(null), onClick: () => this.set('layout', l.id) }));
    if (!split && cs.id === 'heating') options = Object.entries(D.HEATING).map(([k, v]) => ({ tag: 'Zone ' + req.climateZone + ' · ' + zone, label: v.name, note: v[zone],
      style: card(s.heating === k), swatchStyle: sw(null), onClick: () => this.setState({ heating: k }) }));
    const heat = D.HEATING[s.heating] || D.HEATING.default;
    // The summary and report use the catalogue's options where loaded.
    const cladOpt = catOk && cat.cladding ? cat.cladding.options.find((o) => o.id === req.cladding) : null;
    const cladColour = (s.cladColour || {})[req.cladding];
    const upperColour = (s.cladColour || {})[req.cladding + '.upper'];
    const twoStorey = req.cladding !== 'A';
    const heatOpt = catOk && cat.heating ? cat.heating.options.find((o) => o.id === s.heating) || cat.heating.options[0] : null;
    const sheets = catOk ? (cat.customise.layout || []).filter((d) => d.id) : [];
    const ticked = this.tickedLayouts(sheets, req);
    const customRows = [
      { label: 'Buildings', value: opt.blocks.map((b) => b.code).join(' + '), note: '' },
      cladOpt ? { label: 'Cladding', value: cladOpt.name.replace(/^Option (.): /, '$1 — ') +
          (twoStorey ? ' · ' + cladParts(blk).lower.toLowerCase() + ' ' + (cladColour || 'colour to choose') + ' · ' + cladParts(blk).upper.toLowerCase() + ' profiled metal ' + (upperColour || 'colour to choose') : cladColour ? ' · ' + cladColour : ''),
        note: twoStorey ? cladParts(blk).lower + ' colour from ' + cladOpt.supplier + ', upper storey from the profiled metal range' : cladOpt.supplier ? 'Colour from ' + cladOpt.supplier : '' }
        : { label: 'Cladding', value: D.CLADDING[req.cladding].name, note: D.CLADDING[req.cladding].notes },
      sheets.length ? { label: 'Teaching layouts', value: sheets.filter((d) => ticked.includes(d.id)).map((d) => d.sheet).join(', ') || 'None ticked', note: '' }
        : { label: 'Teaching layout', value: req.layout.name, note: req.layout.summary },
      heatOpt ? { label: 'Heating and ventilation', value: heatOpt.name + ' · zone ' + req.climateZone, note: heatOpt.text }
        : { label: 'Heating and ventilation', value: heat.name + ' · zone ' + req.climateZone, note: heat[zone] },
      { label: 'Roof', value: blk.roof, note: '' }
    ];
    // Real PDF pages from the catalogue once they've loaded; the design's
    // placeholder boxes until then (or for a step the catalogue has no pages for).
    const stepDocs = (c) => (catOk && cat.customise[c.id] ? this.pageDocs(cat.customise[c.id]) : c.docs.map((d) => this.docItem(d)));
    // Supporting documentation, grouped by topic: only the layout sheets the
    // school ticked, then the cladding and heating pages, gym / hall pages and
    // the other further-information pages, each page listed once.
    const seen = new Set();
    const docRows = (list) => list.filter((d) => { const k = d.sourceTitle + '|' + d.page; if (seen.has(k)) return false; seen.add(k); return true; })
      .map((d) => ({ title: d.title, meta: (d.sheet ? 'Sheet ' + d.sheet + ' · ' : '') + 'p.' + d.page }));
    const docGroups = !catOk ? [] : [
      { title: 'Teaching space layouts', docs: docRows(sheets.filter((d) => ticked.includes(d.id))) },
      { title: 'Cladding', docs: docRows(cat.customise.cladding || []) },
      { title: 'Heating and ventilation', docs: docRows(cat.customise.heating || []) },
      { title: 'Gyms and halls', docs: docRows(cat.diagrams.groups.filter((g) => g.key === 'gym' || g.key === 'hall')
        .flatMap((g) => g.layouts.map((l) => ({ title: l.title, page: l.pages[0].page, sourceTitle: l.source.title })))) },
      ...cat.sections.map((sc) => ({ title: sc.title, docs: docRows(sc.docs) }))
    ].filter((g) => g.docs.length);
    // The two paths: requirements (the Ministry works out the building) or a
    // building code entered directly (the requirement section is left out).
    const byCode = !!req.direct;
    const no = (n) => String(n - (byCode ? 1 : 0)).padStart(2, '0');
    const rb = this.box('report', 380, 250);
    const rg = this.geometry(opt.blocks, Math.max(200, rb.w - 40), { maxM: 7, minM: 1.6, labels: false });
    const w = s.wz || {};
    return {
      cScreenLabel: 'Customise · ' + cs.title, cTitle: cs.title,
      cIntro: cs.id === 'heating' ? cs.intro + ' This site is climate zone ' + req.climateZone + ' (' + zone + ' band).' : cs.intro,
      cSteps: CUSTOM_STEPS.map((c, i) => {
        const st = i < step ? 'done' : i === step ? 'current' : 'next';
        return { label: String(i + 1).padStart(2, '0') + ' ' + c.title,
          style: 'display:flex;align-items:center;gap:10px;background:transparent;border:none;padding:6px 0;cursor:pointer;color:' + INK +
            ";font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase;opacity:" + (st === 'next' ? 0.4 : st === 'done' ? 0.7 : 1) + ';',
          chevStyle: this.chev(st === 'done' ? 405 : st === 'current' ? 315 : 225, INK, 8) + 'margin:' + (st === 'next' ? '4px' : st === 'done' ? '-4px' : '0') + ' 0 0 0;',
          onClick: () => this.setState({ cStep: i }) };
      }),
      cHasOptions: options.length > 0, cOptions: options,
      cSplit: !!split, cChoices: split ? split.choices : [],
      ...(split ? split.detail : { cdKicker: '', cdTitle: '', cdHasImage: false, cdHasText: false, cdParas: [], cdBullets: [], cdHasNote: false, cdHasSource: false }),
      cIsSummary: cs.id === 'summary', customRows,
      cIsSpg: cs.id === 'spg', ...this.spgVals(req),
      cKicker: 'Customise · ' + opt.blocks.map((b) => b.code).join(' + '),
      reportTitle: opt.blocks.map((b) => b.code).join(' + '),
      reportBuildings: opt.blocks.map((b) => ({ code: b.code, name: b.name,
        detail: b.perFloor ? `${b.perFloor} per floor · ${b.teachingSpaces} teaching spaces · ${n0(b.gfa)} m² gross` : b.summary || '' })),
      cHasDocs: stepDocs(cs).length > 0, cDocs: stepDocs(cs),
      cBackLabel: step === 0 ? 'Building' : 'Back',
      cOnBack: () => (step === 0 ? this.go('building') : this.setState({ cStep: step - 1 }, () => window.scrollTo(0, 0))),
      cHasNext: step < CUSTOM_STEPS.length - 1,
      cOnNext: () => this.setState({ cStep: step + 1 }, () => window.scrollTo(0, 0)),
      onReport: () => this.go('report'),
      onReportBack: () => this.go('customise', { cStep: CUSTOM_STEPS.length - 1 }),
      onPrint: () => window.print(),
      reportDate: new Date().toLocaleDateString('en-NZ', { day: 'numeric', month: 'long', year: 'numeric' }),
      reportSchool: [this.state.input.schoolName, w.region, this.state.input.schoolTypeLabel].filter(Boolean).join(' · ') || 'School not specified',
      reportDocGroups: docGroups, reportHasDocs: docGroups.length > 0, reportNoDocs: docGroups.length === 0,
      reportShowReq: !byCode,
      rReqLabel: '01 · Requirement',
      rBuildLabel: no(2) + ' · ' + (byCode ? 'Building module (entered by code)' : 'Suggested building module for school'),
      rCustLabel: no(3) + ' · Customisation', rSpgLabel: no(4) + ' · SPG schedule', rDocsLabel: no(5) + ' · Supporting documentation',
      reportBoxRef: this.boxRef('report'),
      reportFaces: rg.faces, reportSceneStyle: this.scene(rg),
      reportStageStyle: this.stage(58, -36, this.fitZoom(rg, Math.max(180, rb.w - 40), Math.max(150, rb.h - 40), 58, -36), 0, 8)
    };
  }

  /* ---------- opening question flow ---------- */
  setW(k, v) { this.setState((st) => ({ wz: { ...st.wz, [k]: v } })); }
  togW(k, v) {
    this.setState((st) => {
      const cur = st.wz[k] || [];
      return { wz: { ...st.wz, [k]: cur.includes(v) ? cur.filter((x) => x !== v) : [...cur, v] } };
    });
  }
  finishQuiz() {
    const w = this.state.wz;
    const ratio = Number(this.props.spaceRatio) || 25;
    const teaching = w.buildings.includes('teaching');
    const ts = w.mode === 'ts' ? Number(w.tsRequired) || 0 : Math.ceil((Number(w.rollGrowth) || 0) / ratio);
    const roll = w.mode === 'ts' ? ts * ratio : Number(w.rollGrowth) || 0;
    const region = REGIONS.find((r) => r.label === w.region);
    const mix = w.specMix || {};
    const specTypes = this.specOpts().map((o) => o.key).filter((k) => (mix[k] || 0) > 0);
    const specTotal = specTypes.reduce((t, k) => t + mix[k], 0) || (teaching ? Number(w.specCount) || 0 : 0);
    this.setState({
      screen: 'review', section: 0, optionId: null, bayId: null, zoneId: null,
      input: {
        ...DEFAULTS,
        // Two school categories [guide §1]: they set the modules, the building
        // types offered and which Ministry documents are shown.
        category: w.schoolType === 'Secondary / intermediate school' ? 'secondary' : 'primary_intermediate',
        schoolName: w.location, schoolTypeLabel: w.schoolType,
        schoolType: w.schoolType === 'Secondary / intermediate school' ? 'Secondary / intermediate' : 'Primary',
        roll: teaching ? roll : 0, rollFuture: teaching ? roll : 0, tsExisting: 0,
        specialist: teaching ? specTotal : 0,
        specialistTypes: teaching ? specTypes : [],
        library: w.buildings.includes('library') ? 'Yes' : 'No',
        admin: w.buildings.includes('admin') ? 'Yes' : 'No',
        amenities: teaching ? 'Yes' : 'No',
        gym: w.buildings.includes('gym') ? 'Yes' : 'No', gymCourts: String(w.gymCourts || 1),
        hall: w.buildings.includes('hall') ? 'Yes' : 'No',
        climate: region ? region.zone : '3'
      },
      picks: {}, blockId: null
    });
    window.scrollTo(0, 0);
  }
  qOpt(active) {
    return 'display:flex;flex-direction:column;align-items:flex-start;gap:7px;text-align:left;width:100%;' +
      'padding:19px 20px;cursor:pointer;transition:background 140ms ease,border-color 140ms ease;' +
      'border:1px solid ' + (active ? '#fff' : 'rgba(255,255,255,0.4)') + ';' +
      'background:' + (active ? '#fff' : 'rgba(255,255,255,0.05)') + ';color:' + (active ? INK : '#fff') + ';';
  }
  qNote(active) {
    return "font:400 12px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.03em;color:" +
      (active ? '#6E5A6E' : 'rgba(255,255,255,0.58)') + ';';
  }
  qMode(active) {
    return 'padding:13px 18px;cursor:pointer;font:500 11px/1 \'IBM Plex Mono\',monospace;letter-spacing:0.12em;text-transform:uppercase;' +
      'border:1px solid ' + (active ? '#fff' : 'rgba(255,255,255,0.4)') + ';' +
      'background:' + (active ? '#fff' : 'transparent') + ';color:' + (active ? INK : 'rgba(255,255,255,0.8)') + ';';
  }
  quizVals() {
    const s = this.state, w = s.wz;
    const ratio = Number(this.props.spaceRatio) || 25;
    const teaching = w.buildings.includes('teaching');
    const flow = ['type', 'size', 'buildings', ...(w.buildings.includes('gym') ? ['gym'] : []), ...(teaching ? ['specialist'] : []), 'location'];
    const step = clamp(s.qStep, 0, flow.length - 1);
    const id = flow[step];
    const goStep = (i) => {
      if (i < 0) return this.go('cover');
      if (i >= flow.length) return this.finishQuiz();
      this.setState({ qStep: i }); window.scrollTo(0, 0);
    };
    const single = (key, list) => list.map((o) => {
      const active = w[key] === o.label;
      return { label: o.label, note: o.note || '', style: this.qOpt(active), noteStyle: this.qNote(active), onClick: () => this.setW(key, o.label) };
    });
    const multi = (key, list) => list.map((o) => {
      const active = (w[key] || []).includes(o.key);
      return { label: o.label || o.key, note: o.note || '', style: this.qOpt(active), noteStyle: this.qNote(active), onClick: () => this.togW(key, o.key) };
    });

    const mix = w.specMix || {};
    const allocated = this.specOpts().reduce((t, o) => t + (mix[o.key] || 0), 0);
    const specTarget = Number(w.specCount) || 0;
    const setMix = (k, v) => this.setState((st) => ({ wz: { ...st.wz, specMix: { ...(st.wz.specMix || {}), [k]: Math.max(0, v) } } }));

    let q = {};
    if (id === 'type') {
      q = { label: 'School type', title: 'What type of school is this?',
        intro: 'School type sets the teaching module and the building types available. Primary schools use single-depth S types on the B module; secondary and intermediate schools use the A module and can also have double-depth D types.',
        options: single('schoolType', [
          { label: 'Primary school', note: 'Contributing and full primary · B module, 7.2 m × 12 m · S1–S3 · hall H3' },
          { label: 'Secondary / intermediate school', note: 'Years 7–13 · A module, 7.2 m × 10.3 m · S1–S3 and D1–D3 · halls H8 / H9' }
        ]) };
    } else if (id === 'gym') {
      q = { label: 'Gymnasium', title: 'How many courts does the gym need?',
        intro: 'One court: G1 or G2, single-court gyms with different amenity arrangements. Two courts: G4, the double-court gym.',
        options: [1, 2].map((n) => {
          const active = Number(w.gymCourts || 1) === n;
          return { label: n === 1 ? 'Single court' : 'Double court', note: n === 1 ? 'G1 or G2' : 'G4',
            style: this.qOpt(active), noteStyle: this.qNote(active), onClick: () => this.setW('gymCourts', n) };
        }) };
    } else if (id === 'size') {
      const derived = w.mode === 'ts'
        ? Math.max(0, Number(w.tsRequired) || 0) * ratio + ' students at ' + ratio + ' per space'
        : Math.ceil((Number(w.rollGrowth) || 0) / ratio) + ' teaching spaces at ' + ratio + ' students per space';
      q = { label: 'Roll growth', title: 'How much growth are you providing for?',
        intro: 'Enter roll growth, or go straight to the number of teaching spaces if that is already known. Equivalent: ' + derived + '.',
        modes: [
          { label: 'Roll growth', style: this.qMode(w.mode === 'roll'), onClick: () => this.setW('mode', 'roll') },
          { label: 'Teaching spaces known', style: this.qMode(w.mode === 'ts'), onClick: () => this.setW('mode', 'ts') }
        ],
        number: w.mode === 'ts'
          ? { key: 'tsRequired', value: Number(w.tsRequired) || 0, unit: 'spaces', step: 1, min: 0, max: 40 }
          : { key: 'rollGrowth', value: Number(w.rollGrowth) || 0, unit: 'students', step: 10, min: 0, max: 1500 } };
    } else if (id === 'buildings') {
      q = { label: 'Buildings required', title: 'Which buildings do you need?',
        intro: 'Select everything in scope. Each building gets its own section of options, and you review them one after another.',
        options: multi('buildings', BUILD_OPTS) };
    } else if (id === 'specialist') {
      const stage2 = w.specStage === 1 && specTarget > 0;
      q = { label: 'Specialist teaching', title: 'How many specialist teaching spaces are required?',
        intro: stage2
          ? 'Allocate the ' + specTarget + ' specialist space' + (specTarget === 1 ? '' : 's') + ' across the standard specialist fit-outs. They take standard teaching bays in the building: up to 4 per floor, typically 1–3.'
          : 'A specialist space is a standard teaching bay with a specialist fit-out, up to 4 per floor (typically 1–3). Enter the total required, then set the mix. Leave at zero if none are required.',
        number: { key: 'specCount', value: specTarget, unit: 'spaces', step: 1, min: 0, max: 12 },
        inlineNext: specTarget > 0 && !stage2,
        onInlineNext: () => this.setState((st) => ({ wz: { ...st.wz, specStage: 1 } })),
        counters: stage2 ? this.specOpts().map((o) => {
          const count = mix[o.key] || 0;
          return {
            label: o.key, note: o.note, count: String(count),
            rowStyle: 'display:flex;align-items:center;justify-content:space-between;gap:18px;padding:16px 18px;' +
              'border:1px solid ' + (count ? '#fff' : 'rgba(255,255,255,0.4)') + ';' +
              'background:rgba(255,255,255,' + (count ? '0.12' : '0.05') + ');color:#fff;',
            noteStyle: "font:400 11.5px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.03em;color:rgba(255,255,255,0.58);",
            onMinus: () => setMix(o.key, count - 1),
            onPlus: () => allocated < specTarget && setMix(o.key, count + 1)
          };
        }) : null,
        allocated: stage2 ? allocated + ' of ' + specTarget + ' allocated' + (allocated === specTarget ? ' · complete' : '') : '' };
    } else {
      q = { label: 'School location', title: 'Where is the school?',
        intro: 'Location sets the NZBC climate zone, which determines the heating and ventilation provided with the standard design.',
        text: true,
        options: single('region', REGIONS) };
    }

    const num = q.number;
    return {
      qLabel: q.label, qNo: String(step + 1).padStart(2, '0'), qTotal: String(flow.length).padStart(2, '0'),
      qDots: flow.map((_, i) => ({ style: 'width:' + (i === step ? '26px' : '10px') + ';height:3px;display:block;background:' + (i <= step ? '#fff' : 'rgba(255,255,255,0.3)') + ';' })),
      qTitle: q.title, qIntro: q.intro,
      qHasOptions: !!(q.options && q.options.length), qOptions: q.options || [],
      qHasModes: !!q.modes, qModes: q.modes || [],
      qIsNumber: !!num, qValue: num ? num.value : 0, qUnit: num ? num.unit : '',
      qOnMinus: () => num && this.setW(num.key, clamp(num.value - num.step, num.min, num.max)),
      qOnPlus: () => num && this.setW(num.key, clamp(num.value + num.step, num.min, num.max)),
      qOnChange: (e) => num && this.setW(num.key, clamp(Number(e.target.value) || 0, num.min, num.max)),
      qShowInlineNext: !!q.inlineNext, qOnInlineNext: q.onInlineNext || (() => {}),
      qIsCounters: !!q.counters, qCounters: q.counters || [], qAllocated: q.allocated || '',
      qIsText: !!q.text, qText: w.location, qOnText: (e) => this.setW('location', e.target.value),
      qOnBack: () => (id === 'specialist' && w.specStage === 1 ? this.setState((st) => ({ wz: { ...st.wz, specStage: 0 } })) : goStep(step - 1)),
      qOnNext: () => {
        // On the specialist step: only allow Next when either the count is 0
        // or all allocations have been made. Otherwise the user must complete
        // the counters underneath the question first.
        if (id === 'specialist' && specTarget > 0 && allocated !== specTarget) return;
        goStep(step + 1);
      },
      qNextStyle: (() => {
        const disabled = id === 'specialist' && specTarget > 0 && allocated !== specTarget;
        const base = "display:inline-flex;align-items:center;gap:10px;border:1px solid #fff;padding:16px 26px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase;transition:background 160ms ease,border-color 160ms ease,opacity 160ms ease;";
        return disabled
          ? base + "background:transparent;color:rgba(255,255,255,0.45);border-color:rgba(255,255,255,0.28);cursor:not-allowed;opacity:0.6;"
          : base + "background:#fff;color:#2C112D;cursor:pointer;";
      })(),
      qNextLabel: step === flow.length - 1 ? 'Find building options' : 'Next'
    };
  }

  // Further information under the building: the relevant layout sheets first,
  // then the catalogue sections for this building, all from the Rails API.
  infoVals(blk, req) {
    const s = this.state;
    const data = this.buildingData(blk, req);
    if (!data || data.error) return { infoSections: [], infoLoading: !data, infoError: !!(data && data.error) };
    const rowBase = 'display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid #EDEFEC;font-size:13.5px;';
    const section = (id, n, title, sub, extra) => {
      const open = s.openInfo.includes(id);
      return {
        id, n: String(n).padStart(2, '0'), title, sub, open,
        chevStyle: this.chev(open ? 405 : 315, INK, 11) + 'margin:' + (open ? '-6px' : '0') + ' 0 0 8px;',
        onToggle: () => this.setState((st) => ({ openInfo: st.openInfo.includes(id) ? st.openInfo.filter((x) => x !== id) : [...st.openInfo, id] })),
        isDiagrams: false, groups: [], hasNotes: false, notes: [], hasExcluded: false, excluded: [], hasNoGroups: false, blocks: [],
        hasDocs: false, docs: [],
        ...extra
      };
    };
    const d = data.diagrams;
    const sheets = d.groups.flatMap((g) => g.layouts);
    // The design's document card. The sheet is shown whole (contain, not
    // cover) so its title block stays in view; clicking opens the viewer,
    // while the link itself still points at the PDF page.
    const card = (l) => {
      const doc = this.docItem({ title: l.title, src: l.source.url, thumb: l.pages[0].thumb });
      return { ...doc, boxStyle: doc.boxStyle.replace('/ cover', '/ contain'),
        status: [l.pages[0].sheet, l.occupancy, l.module && 'Module ' + l.module, l.pages.length > 1 && l.pages.length + ' sheets'].filter(Boolean).join(' · '),
        onClick: (e) => { e.preventDefault(); this.openSheet(sheets, sheets.indexOf(l)); } };
    };
    const layouts = section('layouts', 1, 'Layouts', 'Standard layout sheets for this building and your requirements', {
      isDiagrams: true,
      groups: d.groups.map((g) => ({ label: g.label, note: g.note || '', hasNote: !!g.note, cards: g.layouts.map(card) })),
      hasNotes: d.notes.length > 0, notes: d.notes,
      hasExcluded: d.excluded.length > 0, excluded: d.excluded.map((e) => `${e.title} — ${e.reason}`),
      hasNoGroups: d.groups.length === 0
    });
    const block = (b) => ({
      heading: b.heading, paras: b.paragraphs, hasBullets: b.bullets.length > 0, bullets: b.bullets, after: b.after,
      hasRows: b.rows.length > 0,
      rows: b.rows.map((r) => ({ label: r.label, value: r.value,
        style: rowBase + (r.highlight ? 'font-weight:600;background:#F7F6F7;padding-left:10px;padding-right:10px;' : '') })),
      hasZoneNote: !!b.zoneNote, zoneNote: b.zoneNote || '',
      hasSource: true, sourceLabel: `${b.source.title} · p.${b.source.page}`, sourceUrl: b.source.url
    });
    // A summary section (climate) opens with the site as entered in the
    // requirements; the catalogue rows for its climate zone follow.
    const w = s.wz || {};
    const region = REGIONS.find((r) => r.label === w.region);
    const siteBlock = {
      heading: 'Your site', paras: [], hasBullets: false, bullets: [], after: [], hasRows: true,
      rows: [
        ...(w.location ? [{ label: 'Location', value: w.location }] : []),
        { label: 'Region', value: region ? `${region.label} (${region.note})` : '—' },
        { label: 'NZBC climate zone', value: `Zone ${req.climateZone}` }
      ].map((r) => ({ ...r, style: rowBase })),
      hasZoneNote: false, zoneNote: '', hasSource: false, sourceLabel: '', sourceUrl: ''
    };
    // The building type's typology diagrams from the catalogue (p7 sections,
    // the p8 D example), now shown as the Diagrams accordion (O2).
    const typ = data.typology || [];
    const typCards = this.cropCards(typ, (t) => t.caption[0]);
    const typGroup = typ.length ? [{
      label: typ[0].source.title + ' · p.' + [...new Set(typ.map((t) => t.page))].join(', '),
      note: '', hasNote: false,
      cards: typ.map((t, i) => {
        const doc = this.docItem({ title: t.caption[0], src: t.source.url, thumb: t.src });
        return { ...doc, boxStyle: doc.boxStyle.replace('/ cover', '/ contain'),
          status: t.caption.slice(1).join(' · ') || '',
          onClick: (e) => { e.preventDefault(); this.openSheet(typCards, i); } };
      })
    }] : [];
    const diagrams = section('diagrams', 2, 'Diagrams', 'Building type diagrams from the standard designs catalogue', {
      isDiagrams: true, groups: typGroup, hasNotes: false, notes: [],
      hasExcluded: false, excluded: [], hasNoGroups: typGroup.length === 0
    });
    const rest = data.sections.map((sc, i) => section(sc.id, i + 3, sc.title, sc.sub, {
      hasDocs: sc.docs.length > 0, docs: this.pageDocs(sc.docs),
      blocks: [...(sc.summary ? [siteBlock] : []), ...sc.blocks.map(block)]
    }));
    return {
      infoSections: [layouts, diagrams, ...rest], infoLoading: false, infoError: false,
      hasTypology: false
    };
  }

  // Enlarged view of one layout sheet, stepping through the sheets shown on the page.
  lightboxVals() {
    const lb = this.state.lb;
    if (!lb) return { lbOpen: false, lbTabs: [] };
    const c = lb.cards[lb.i];
    const p = c.pages[lb.page] || c.pages[0];
    const dim = (on) => this.btn(false) + (on ? '' : 'opacity:0.35;pointer-events:none;');
    return {
      lbOpen: true, lbTitle: c.title,
      lbMeta: [p.sheet ? 'Sheet ' + p.sheet : 'Page ' + p.page, c.occupancy, c.module && 'Module ' + c.module].filter(Boolean).join(' · '),
      // Sheets are ISO A1/A3 landscape (√2), rendered 2600 px on the long side.
      lbImgStyle: `display:block;background:#fff url('${p.full}') center / contain no-repeat;aspect-ratio:${p.aspect || 1.4142};` +
        (lb.zoom ? 'width:2600px;max-width:none;cursor:zoom-out;' : 'width:100%;cursor:zoom-in;'),
      lbOnZoom: () => this.setState((st) => ({ lb: { ...st.lb, zoom: !st.lb.zoom } })),
      lbZoomLabel: lb.zoom ? 'Fit to screen' : 'Actual size',
      lbHasTabs: c.pages.length > 1,
      lbTabs: c.pages.map((pg, k) => ({ label: pg.sheet || 'Page ' + pg.page, style: this.btn(k === lb.page),
        onClick: () => this.setState((st) => ({ lb: { ...st.lb, page: k, zoom: false } })) })),
      lbCount: `${lb.i + 1} of ${lb.cards.length}`,
      lbPrevStyle: dim(lb.i > 0), lbNextStyle: dim(lb.i < lb.cards.length - 1),
      lbOnPrev: () => this.moveSheet(-1), lbOnNext: () => this.moveSheet(1),
      lbOnClose: () => this.setState({ lb: null }),
      lbOnBackdrop: (e) => { if (e.target === e.currentTarget) this.setState({ lb: null }); },
      lbSourceLabel: `${c.source.title} · p.${p.page}`,
      lbSourceUrl: c.source.url.replace(/#.*$/, '') + '#page=' + p.page
    };
  }

  // Cover slide-out panels. About has three tabs drawn from the catalogue of the
  // current school category: About (p.2), Acknowledgements (p.3) and How the
  // building works (p.8).
  panelVals() {
    const s = this.state;
    // About and Graphics are full pages (screens); the side panel remains for
    // any other panel.
    const about = s.panel === 'about' || s.screen === 'about';
    const graphics = s.panel === 'graphics' || s.screen === 'graphics';
    const ab = about || graphics ? this.aboutData() : null;
    const ok = !!(ab && !ab.error);
    const P = s.panel ? PANELS[s.panel] : about ? PANELS.about : graphics ? PANELS.graphics : null;
    const tabs = P && P.tabs ? P.tabs : null;
    const act = tabs ? tabs.find((t) => t.id === s.panelTab) || tabs[0] : null;
    const tab = act ? act.id : 'about';
    const srcLabel = (src) => src ? `${src.title} · ${src.version}${src.page ? ' · p.' + src.page : ''}` : '';
    // The design's blocks describe the tool; any that state catalogue facts are
    // replaced by the catalogue's own text for the school's category.
    const designBlocks = act ? act.blocks : P ? P.blocks : [];
    const pick = (label) => designBlocks.find((b) => b.label === label);
    const secondary = ok && ab.category === 'secondary';
    const blocks = !about ? designBlocks
      : tab === 'about' ? (secondary ? [{ label: 'Catalogue', text: `${ab.catalogue.title}, ${ab.catalogue.version}.` }, pick('Status')] : designBlocks)
      : tab === 'ack' ? (!ok ? [] : [secondary ? { label: 'Source', text: `${ab.catalogue.title}, ${ab.catalogue.version}. Te Tāhuhu o te Mātauranga — Ministry of Education.` } : pick('Source'), pick('Graphic language')])
      : [];
    // How buildings are created: the catalogue's page replaces the design's
    // module summary; the blocks on the tool's own selection and customisation follow it.
    const afterBlocks = about && tab === 'how' && ok ? designBlocks.filter((b) => /Selection|Customisation/.test(b.label)) : [];
    const src = !ok || !about ? null : tab === 'about' ? ab.about.source : tab === 'ack' ? ab.acknowledgements.source : ab.howItWorks.source;
    // Images are bound as backgrounds: an <img src="{{ }}"> would be fetched
    // literally when the page first parses, before the runtime binds it.
    const tile = (src) => `display:block;background:#fff url('${src}') center / contain no-repeat;background-origin:content-box;padding:14px;`;
    return {
      showPanel: !!s.panel,
      panelTitle: s.panel ? PANELS[s.panel].title : '',
      panelBlocks: blocks, panelAfterBlocks: afterBlocks,
      onClosePanel: () => this.setState({ panel: null }),
      panelHasTabs: !!tabs,
      panelTabs: (tabs || []).map((t) => ({ label: t.label, onClick: () => this.setState({ panelTab: t.id }),
        style: 'padding:11px 14px;cursor:pointer;font:500 10.5px/1 \'IBM Plex Mono\',monospace;letter-spacing:0.1em;text-transform:uppercase;' +
          'border:1px solid ' + (t === act ? '#fff' : 'rgba(255,255,255,0.4)') + ';background:' + (t === act ? '#fff' : 'transparent') + ';color:' + (t === act ? INK : '#fff') + ';' })),
      // The About page's tabs, in the app's own button style.
      pageTabs: (tabs || []).map((t) => ({ label: t.label, style: this.btn(t === act), onClick: () => this.setState({ panelTab: t.id }) })),
      pageTitle: P ? P.title : '',
      onPageBack: () => this.go('cover'),
      panelLoading: (about || graphics) && !ab,
      panelError: (about || graphics) && !!ab && !ok,
      panelCategory: ok ? ab.categoryLabel : '',
      showAboutIntro: ok && about && tab === 'about', aboutParas: ok ? ab.about.paragraphs : [],
      // How it all works: the catalogue's own diagrams (p4, p8), enlargeable.
      showAboutFigures: ok && about && tab === 'about',
      aboutFigures: ok ? (() => {
        const cards = this.cropCards(ab.figures, (f) => f.title);
        return ab.figures.map((f, i) => ({ title: f.title, onOpen: () => this.openSheet(cards, i),
          tileStyle: tile(f.src) + `width:100%;margin-top:14px;border:none;cursor:zoom-in;aspect-ratio:${f.aspect};` }));
      })() : [],
      ...(graphics && ok ? this.graphicsVals(ab, tile) : { showGraphics: false, gfxLayouts: [], gfxRenderGroups: [] }),
      showAck: ok && (tab === 'ack' || s.screen === 'about'), ackParas: ok ? ab.acknowledgements.paragraphs : [],
      ackGroups: ok ? ab.acknowledgements.groups.map((g) => ({
        label: g.label, logos: g.logos.map((l) => ({ name: l.name, tileStyle: tile(l.src) + 'height:96px;' }))
      })) : [],
      showHow: ok && tab === 'how', howTitle: ok ? ab.howItWorks.title : '', howParas: ok ? ab.howItWorks.paragraphs : [],
      howModules: ok ? ab.howItWorks.modules.map((m) => ({ ...m, tileStyle: tile(m.src) + 'width:132px;height:104px;flex:none;' })) : [],
      howExamples: ok ? ab.howItWorks.examples.map((e) => ({ ...e, hasNote: !!e.note, tileStyle: tile(e.src) + `aspect-ratio:${e.aspect};padding:18px;` })) : [],
      howClosing: ok ? ab.howItWorks.closing : [],
      panelHasSource: !!src, panelSourceLabel: srcLabel(src), panelSourceUrl: src ? src.url : ''
    };
  }

  // About page: four scrollable A/B/C/D subsections with a sticky secondary
  // section nav. Content from the Primary & Intermediate Schools Catalogue
  // pp. 4–7. Graphics come from the catalogue's figure crops when available.
  aboutPageVals() {
    const s = this.state;
    const ab = this.aboutData();
    const ok = ab && !ab.error;
    const figMap = {};
    if (ok) (ab.figures || []).forEach((f) => { figMap[f.page || 0] = f; });
    // Sections A–D use the project team's crops of the catalogue pages
    // (public/about); a section without one falls back to the catalogue figure.
    const cropOf = (se) => (se.img ? { src: se.img.src, aspect: (se.img.w / se.img.h).toFixed(4), page: se.graphicPage,
      source: ok ? { title: `${ab.catalogue.title} · p.${se.graphicPage}`, url: String(ab.catalogue.url || '').replace(/#.*$/, '') + '#page=' + se.graphicPage } : null } : figMap[se.graphicPage]);
    const graphicStyle = (se) => {
      const fig = cropOf(se);
      if (fig) return `display:block;width:100%;aspect-ratio:${fig.aspect};cursor:zoom-in;` +
        `background:#fff url('${fig.src}') center / contain no-repeat;background-origin:content-box;padding:8px;` +
        'border:1px solid #D7DAD7;transition:border-color 160ms ease,transform 220ms cubic-bezier(.3,.7,.2,1);';
      return 'display:block;width:100%;aspect-ratio:1.4142;background:#F7F6F7;border:1px solid #D7DAD7;cursor:zoom-in;' +
        'background-image:' +
          'repeating-linear-gradient(180deg, transparent 0 22px, rgba(44,17,45,0.06) 22px 23px),' +
          'repeating-linear-gradient(90deg, transparent 0 22px, rgba(44,17,45,0.06) 22px 23px);' +
        'transition:border-color 160ms ease,transform 220ms cubic-bezier(.3,.7,.2,1);';
    };
    const seed = [
      { key: 'A', title: 'Introduction', supporting: 'What this guide covers',
        body: [
          'This guide features a range of standard designs for primary and intermediate schools, covering new teaching, library and administration (admin) spaces. It shows the available choices you can tailor to meet your school’s needs and how we will work with you to make those decisions.',
          'It does not cover every school building type or technical requirement. Our website has more detailed information about these options, including technical drawings of teaching spaces for primary and intermediate schools.',
          'How to use this guide:',
          '› the journey from planning to construction and handover',
          '› what decisions are made during planning',
          '› what layout and building material options are available',
          '› what your school can choose and help shape',
          '› what is already set in place by the standard designs.',
          'Your project team will work through with you the parts that apply to your project. Not every option in this guide will apply to every school or site.'
        ],
        smallprint: 'Great schools, great spaces — Standard designs for primary and intermediate schools · V1.0 · p.4',
        graphicCaption: 'From planning to delivery — click to enlarge', graphicPage: 4, img: { src: '/about/a-introduction-p4.png', w: 671, h: 777 } },
      { key: 'B', title: 'What this means for your school', supporting: 'Standardisation for clarity, cost, speed and quality',
        body: [
          'Using standard designs means your school can expect:',
          '› a clearer process from planning through to handover',
          '› open and clear communication from us at every stage of the process',
          '› faster delivery because the key design work has already been done',
          '› high-quality learning spaces',
          '› layout options that we know work well, based on what we’ve heard and learned that best supports student learning.',
          'Some parts of the design — such as structural systems, roofing, acoustic design, ceiling heights and window dimensions — are standard because they help us to better manage cost, quality and delivery time. But other parts can be chosen by you, so the final building works for your site, your students and your way of working.',
          '‘Standard’ does not mean the same. Within these design options, your school has choices — about building placement, how spaces are arranged, what materials best reflect your community and kaupapa, and how your buildings flow and connect with the rest of your environment.'
        ],
        smallprint: 'Great schools, great spaces — Standard designs for primary and intermediate schools · V1.0 · p.5',
        graphicCaption: 'Exterior materials & finishes — click to enlarge', graphicPage: 14, img: { src: '/about/b-finishes-p14.png', w: 1172, h: 806 } },
      { key: 'C', title: 'Planning for your site', supporting: 'Every school site is different',
        body: [
          'Every school site is different. During planning, we work with you to look at how a new building will fit into your wider school environment.',
          'This includes:',
          '› connection to other interior and exterior learning spaces',
          '› existing buildings and heritage features',
          '› services and drainage',
          '› sunlight, shade, trees, and wind protection',
          '› ground conditions',
          '› future development of your school.',
          'Planning also considers how the building can reflect your school’s identity and kaupapa, and support mātauranga Māori where appropriate. The aim is to make the standard design work well in your school and wider community, both now and into the future.'
        ],
        smallprint: 'Great schools, great spaces — Standard designs for primary and intermediate schools · V1.0 · p.6',
        graphicCaption: 'Example site — click to enlarge', graphicPage: 6, img: { src: '/about/c-site-p6.png', w: 916, h: 534 } },
      { key: 'D', title: 'Choosing the right building', supporting: 'Standard building types',
        body: [
          'Standard building types give us a reliable and consistent starting point for new school buildings. Choosing the right type of building for your school depends on your student roll, site, existing buildings, and future plans.',
          'For many primary schools, a single-storey teaching block will be suitable if there is enough space. On tighter sites, a two or three-storey option may be more suitable. In some cases, relocatable buildings may be the best fit for the need, site or timeframe.'
        ],
        smallprint: 'Great schools, great spaces — Standard designs for primary and intermediate schools · V1.0 · p.7',
        graphicCaption: 'Teaching space layouts A–D — click to enlarge', graphicPage: 9, img: { src: '/about/d-layouts-p9.png', w: 857, h: 722 } }
    ];
    const lightboxCards = seed.map((se) => {
      const fig = cropOf(se);
      if (fig) return { title: se.title, occupancy: '', module: '',
        pages: [{ page: fig.page, sheet: null, thumb: fig.src, full: fig.src, aspect: fig.aspect }],
        source: fig.source || { title: 'Standard designs catalogue', url: '' } };
      return { title: 'Section ' + se.key + ' — ' + se.title, occupancy: '', module: '',
        pages: [{ page: 1, sheet: null, thumb: '', full: '', aspect: 1.4142 }],
        source: { title: 'Standard designs catalogue', url: '' } };
    });
    const aboutSections = seed.map((se, i) => ({
      key: se.key, anchor: 'about-' + se.key.toLowerCase(),
      title: se.title, supporting: se.supporting, body: se.body, smallprint: se.smallprint,
      graphicStyle: graphicStyle(se), graphicCaption: se.graphicCaption,
      onOpenGraphic: () => this.openSheet(lightboxCards, i)
    }));
    const active = s.aboutSection || 'A';
    const subNavStyle = (on) =>
      'display:flex;align-items:center;gap:10px;background:transparent;border:none;padding:6px 2px 8px;cursor:pointer;' +
      'color:' + (on ? '#2C112D' : '#8A8189') + ';opacity:' + (on ? '1' : '0.55') + ';' +
      'border-bottom:2px solid ' + (on ? '#2C112D' : 'transparent') + ';';
    return {
      aboutSubNav: seed.map((se) => ({
        key: se.key, label: se.title.replace(/^\[|\]$/g, ''),
        ariaCurrent: se.key === active ? 'true' : 'false',
        style: subNavStyle(se.key === active),
        onClick: () => this.scrollToAbout(se.key)
      })),
      aboutSections
    };
  }

  // Cropped catalogue images as viewer cards: enlarged on screen, with the
  // viewer's source link opening the PDF page.
  cropCards(list, titleOf) {
    return list.map((c) => ({ title: titleOf(c), occupancy: '', module: '',
      pages: [{ page: c.page, sheet: null, thumb: c.src, full: c.src, aspect: c.aspect }],
      source: { title: c.source.title, url: c.source.url } }));
  }
  // The Graphics panel: the catalogue's example layout pages, then its example
  // renders grouped by the page they're on (Examples: Exteriors / Interiors).
  graphicsVals(ab, tile) {
    const docs = this.pageDocs(ab.graphics.layouts);
    const renders = ab.graphics.renders;
    const cards = this.cropCards(renders, (r) => `${r.group} · ${r.title}`);
    const groups = [];
    renders.forEach((r, i) => {
      let g = groups.find((x) => x.title === r.group);
      if (!g) groups.push(g = { title: r.group, items: [] });
      g.items.push({ title: r.title, bullets: r.bullets, onOpen: () => this.openSheet(cards, i),
        tileStyle: `display:block;width:100%;border:none;padding:0;cursor:zoom-in;aspect-ratio:${r.aspect};background:#fff url('${r.src}') center / cover no-repeat;` });
    });
    return {
      showGraphics: true,
      gfxLayouts: ab.graphics.layouts.map((d, i) => ({ title: d.title, meta: 'PDF · p.' + d.page,
        tileStyle: tile(d.thumb) + 'aspect-ratio:1.4142;padding:6px;', onOpen: docs[i].onClick })),
      gfxRenderGroups: groups
    };
  }

  renderVals() {
    const s = this.state;
    const ready = s.ready && !!this.R;
    const screen = s.screen;
    const whiteBg = (this.props.appBackground || 'White + arrow') === 'White + arrow';
    const base = {
      ...this.quizVals(),
      isCover: screen === 'cover', isQuiz: screen === 'quiz', inApp: screen !== 'cover' && screen !== 'quiz' && screen !== 'replay' && screen !== 'direct',
      isReq: screen === 'requirements', isReview: screen === 'review',
      isOptions: screen === 'options', isBuilding: screen === 'building',
      isCustomise: screen === 'customise', isReport: screen === 'report',
      isAboutPage: screen === 'about', isGraphicsPage: screen === 'graphics',
      showTeReo: this.props.showTeReo !== false,
      onStart: () => this.go('quiz', { qStep: 0 }),
      onDirect: () => this.go('direct', { directCode: '', directError: '' }),
      isDirect: screen === 'direct',
      showStepTabs: screen !== 'about' && screen !== 'graphics',
      showNavTabs: screen === 'about' || screen === 'graphics',
      navTabs: [
        { reo: 'Mō tēnei', label: 'About', onClick: () => this.go('about', { panel: null, panelTab: 'about' }) },
        { reo: 'Ngā whakaahua', label: 'Example layouts', onClick: () => this.go('graphics', { panel: null }) },
        { reo: 'Te Tāhuhu o te Mātauranga', label: 'Ministry of Education', onClick: () => window.open('https://www.education.govt.nz/', '_blank', 'noopener') },
        { reo: 'Hākoritanga', label: 'Animation', onClick: () => { this.setState({ screen: 'replay', panel: null }); setTimeout(() => this.setState({ screen: 'cover' }), 60); } }
      ],
      headerNavTabs: [
        { reo: 'Mō tēnei', label: 'About', active: screen === 'about', onClick: () => this.go('about', { panel: null, panelTab: 'about' }) },
        { reo: 'Ngā whakaahua', label: 'Example layouts', active: screen === 'graphics', onClick: () => this.go('graphics', { panel: null }) },
        { reo: 'Te Tāhuhu o te Mātauranga', label: 'Ministry of Education', active: false, onClick: () => window.open('https://www.education.govt.nz/', '_blank', 'noopener') },
        { reo: 'Hākoritanga', label: 'Animation', active: false, onClick: () => { this.setState({ screen: 'replay', panel: null }); setTimeout(() => this.setState({ screen: 'cover' }), 60); } }
      ].map((t) => ({ ...t, style: this.darkBtn(t.active ? 'current' : 'next') })),
      appBg: whiteBg ? '#FFFFFF' : '#F1F3F2',
      reviewBg: whiteBg ? 'transparent' : "linear-gradient(rgba(249,248,249,0.74),rgba(249,248,249,0.86)),#F7F6F7 url('../ref/moe-pattern-light.png') left top / cover no-repeat",
      moeArrow: whiteBg && screen !== 'cover' && screen !== 'quiz' ? this.arrowEl('moe-arrow-' + screen, this.props.arrowSide === 'Left' ? 'left' : 'right') : null,
      ...this.panelVals(),
      ...this.aboutPageVals(),
      ...this.directVals(),
      ...this.lightboxVals(),
      onDemo: () => this.setState({ input: { ...EXAMPLE }, screen: 'review', section: 0, optionId: null, bayId: null }),
      onHome: () => this.go('cover'),
      onBackToReq: () => this.go('requirements'),
      onBackToOptions: () => this.go('options'),
      onCalculate: () => this.go('options'),
      steps: [
        { reo: 'Ngā hiahia', label: 'Requirements', key: 'requirements' },
        { reo: 'Arotake', label: 'Review', key: 'review' },
        { reo: 'Ngā kōwhiringa', label: 'Options', key: 'options' },
        { reo: 'Te whare', label: 'Building', key: 'building' },
        { reo: 'Whakarite', label: 'Customise', key: 'customise' }
      ].map((st, i, all) => {
        const cur = screen === 'report' ? 4 : all.findIndex((x) => x.key === screen);
        const state = i < cur ? 'done' : i === cur ? 'current' : 'next';
        return { ...st, style: this.darkBtn(state),
          chevStyle: this.chev(state === 'done' ? 405 : state === 'current' ? 315 : 225, '#fff', 10) + 'margin:' + (state === 'next' ? '6px' : state === 'done' ? '-6px' : '0') + ' 2px 0 2px;',
          onClick: () => this.go(st.key) };
      })
    };
    if (!ready) return base;

    const { req, options } = this.calc();
    const D = this.D;

    /* ---------- requirements ---------- */
    const sec = SECTIONS[s.section];
    const labelFor = (fieldKey, v) => {
      if (fieldKey === 'layout') return `${v} · ${D.TEACHING_LAYOUTS[v].name.replace(/^Layout . — /, '')}`;
      if (fieldKey === 'cladding') return D.CLADDING[v].name.replace('Option ', '');
      return v;
    };
    const fields = sec.fields.map((f) => {
      const val = s.input[f.key];
      const common = { label: f.label, hint: f.hint || '', note: f.note || false, placeholder: f.placeholder || '' };
      if (f.kind === 'number') {
        const num = Number(val) || 0;
        return { ...common, isNumber: true, value: num, unit: f.unit || '',
          onChange: (e) => this.set(f.key, clamp(Number(e.target.value) || 0, f.min, f.max)),
          onMinus: () => this.set(f.key, clamp(num - f.step, f.min, f.max)),
          onPlus: () => this.set(f.key, clamp(num + f.step, f.min, f.max)) };
      }
      if (f.kind === 'choice') {
        return { ...common, isChoice: true, options: f.options.map((o) => ({
          label: labelFor(f.labelsFrom || '', o) === o ? o : labelFor(f.labelsFrom, o),
          style: this.btn(String(val) === String(o), { pad: '11px 15px' }),
          onClick: () => this.set(f.key, o) })) };
      }
      if (f.kind === 'chips') {
        const cur = val || [];
        return { ...common, isChoice: true, options: f.options.map((o) => ({
          label: o, style: this.btn(cur.includes(o), { pad: '11px 15px' }), onClick: () => this.toggleChip(f.key, o) })) };
      }
      if (f.kind === 'textarea') return { ...common, isTextarea: true, value: val || '', onChange: (e) => this.set(f.key, e.target.value) };
      return { ...common, isText: true, value: val || '', onChange: (e) => this.set(f.key, e.target.value) };
    });

    /* ---------- review ---------- */
    const layoutName = req.layout.name;
    const reviewGroups = [
      { title: 'School', section: 0, rows: [
        { label: 'School', value: s.input.schoolName || '—' },
        { label: 'Type', value: req.schoolLabel },
        { label: 'Current roll', value: `${n0(s.input.roll)} students` },
        { label: 'Projected roll', value: `${n0(s.input.rollFuture)} students` } ] },
      { title: 'Teaching', section: 1, rows: [
        { label: 'Existing retained', value: `${s.input.tsExisting} spaces` },
        { label: 'Specialist required', value: `${s.input.specialist} space${s.input.specialist === 1 ? '' : 's'}` },
        { label: 'Specialist type', value: (s.input.specialistTypes || []).join(', ') || '—' },
        { label: 'Layout', value: layoutName.replace('Layout ', '').split(' — ')[0] } ] },
      { title: 'Support spaces', section: 2, rows: [
        { label: 'Library', value: s.input.library },
        { label: 'Hall', value: s.input.hall },
        { label: 'Gym', value: s.input.gym === 'Yes' ? `Yes · ${req.gymCourts === 2 ? 'double' : 'single'} court` : 'No' },
        { label: 'Administration', value: s.input.admin },
        { label: 'Staff facilities', value: s.input.staffIncluded },
        { label: 'Amenities', value: s.input.amenities },
        { label: 'Storage', value: s.input.storage } ] },
      { title: 'Site', section: 5, rows: [
        { label: 'Site area', value: s.input.siteArea },
        { label: 'Max storeys', value: s.input.maxStoreys },
        { label: 'Climate zone', value: `Zone ${s.input.climate}` },
        { label: 'Existing retained', value: `${s.input.existingRetained} buildings` } ] }
    ].map((g) => ({ ...g, onEdit: () => this.setState({ screen: 'requirements', section: g.section }) }));

    const calcRows = [
      { label: 'Roll sized against', value: `${n0(req.roll)} students` },
      { label: 'Students per teaching space', value: String(req.ratio) },
      { label: 'Teaching space entitlement', value: `${req.tsEntitlement} spaces` },
      { label: 'Less existing retained', value: `− ${req.tsExisting} spaces` },
      { label: 'New general teaching', value: `${req.tsNew} spaces` },
      { label: 'New specialist teaching', value: `${req.specialist} spaces` },
      { label: 'Resource / admin / toilets', value: 'Within each S / D building' },
      ...req.companions.map((c) => ({ label: c.label, value: c.codes.join(' or ') })),
      { label: 'Library modules', value: req.libraryModules ? `${req.libraryModules} · ${req.libraryLayout.name}` : 'Not in scope' },
      { label: 'Admin modules', value: req.adminModules ? `${req.adminModules} · ${req.adminLayout.name}` : 'Not in scope' },
      { label: 'Services', value: `Climate zone ${req.climateZone} · default` }
    ];

    /* ---------- options ---------- */
    const fitColour = (score) => (score === 100 ? INK : score >= 80 ? '#5A6E7A' : '#9A3B32');
    const chosenTeaching = (options.find((o) => o.id === s.optionId) || options[0] || {}).id;
    const optionCards = options.map((o) => {
      const cb = this.box('card', 320, 210);
      const g = this.geometry(o.blocks, Math.max(160, cb.w - 32), { maxM: 5.6, minM: 1.6, labels: false });
      const gz = this.fitZoom(g, Math.max(140, cb.w - 32), Math.max(110, cb.h - 34), 58, -36);
      const on = o.id === chosenTeaching;
      const meets = o.fit.score === 100;
      return {
        id: o.id, title: o.title, summary: o.summary, characteristics: o.characteristics,
        cardStyle: `background:#fff;border:1px solid ${on ? INK : '#D7DAD7'};box-shadow:${on ? '0 0 0 1px ' + INK : 'none'};`,
        tag: meets ? 'Meets requirements' : 'Partly meets',
        tagStyle: `font:500 9.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;padding:5px 8px;` +
          `background:${meets ? '#EAEDEA' : '#F4E4E2'};color:${meets ? '#4F5A54' : '#9A3B32'};`,
        fitText: `FIT ${o.fit.score}%`,
        fitStyle: `font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.08em;color:${fitColour(o.fit.score)};`,
        faces: g.faces, stageStyle: this.stage(58, -36, gz, 0, 10), sceneStyle: this.scene(g),
        ...(screen === 'options' ? this.cardModelVals(o) : { showMassing: true, hasModel: false }),
        stats: [
          { label: 'Teaching spaces', value: String(o.totals.teachingSpaces) },
          { label: 'Storeys', value: String(o.totals.storeys) },
          { label: 'Gross floor area', value: `${n0(o.totals.gfa)} m²` },
          { label: 'Footprint', value: `${n0(o.totals.footprint)} m²` }
        ],
        selectLabel: on ? '✓ Selected' : 'Select this option',
        selectStyle: `width:100%;background:${on ? INK : 'transparent'};border:1px solid ${INK};color:${on ? '#fff' : INK};padding:14px 16px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;`,
        onView: () => this.setState({ optionId: o.id, blockId: null, bayId: null, zoneId: null })
      };
    });

    // One section per building asked for; the school picks one option in each.
    const pickCard = (on) => 'display:flex;flex-direction:column;align-items:flex-start;gap:8px;text-align:left;width:100%;padding:18px 18px 20px;cursor:pointer;' +
      `border:1px solid ${on ? INK : '#D7DAD7'};background:${on ? INK : '#fff'};color:${on ? '#fff' : INK};transition:background 160ms ease;`;
    const setPick = (k, v) => this.setState((st) => ({ picks: { ...(st.picks || {}), [k]: v }, blockId: null, bayId: null }));
    const sectionDefs = this.pickSections(req, options);
    const pickSectionsList = sectionDefs.map((sc, i) => {
      const no = String(i + 1).padStart(2, '0');
      if (sc.key === 'teaching') {
        return { no, title: sc.title, isTeaching: true, isSimple: false, cards: [],
          chosen: 'Selected · Option ' + chosenTeaching,
          intro: `${req.tsNew} general and ${req.specialist} specialist teaching space${req.specialist === 1 ? '' : 's'} (${req.totalTeaching} in total). ${req.notes.filter((n) => !/^Building entered/.test(n)).join(' ')}` };
      }
      const cur = this.pickFor(sc.key, req);
      let cards = [], intro = '';
      if (sc.key === 'library' || sc.key === 'admin') {
        const list = Object.values(sc.key === 'library' ? D.LIBRARY_LAYOUTS : D.ADMIN_LAYOUTS);
        const sized = sc.key === 'library' ? req.libraryLayout.id : req.adminLayout.id;
        intro = `Standard ${sc.key === 'library' ? 'library' : 'administration'} layouts. The one sized to a roll of ${n0(req.roll)} is marked.`;
        cards = list.map((l) => ({ tag: l.id === sized ? 'Sized to the roll' : `${l.modules} module${l.modules === 1 ? '' : 's'}`, label: l.name,
          note: `${l.modules} module${l.modules === 1 ? '' : 's'} · suits a ${l.suits.toLowerCase()}`, style: pickCard(l.id === cur), onClick: () => setPick(sc.key, l.id) }));
      } else {
        intro = sc.companion.why + (sc.companion.codes.length > 1 ? ' Choose the amenity arrangement.' : '');
        cards = sc.companion.codes.map((code) => ({ tag: code, label: D.COMPANIONS[code].name.replace(/^\S+ — /, ''), note: D.COMPANIONS[code].note,
          style: pickCard(code === cur), onClick: () => setPick(sc.key, code) }));
      }
      return { no, title: sc.title, isTeaching: false, isSimple: true, cards, intro, chosen: 'Selected · ' + cur };
    });

    /* ---------- building view ---------- */
    const opt = this.option();
    const blk = this.block();
    let building = {};
    if (opt && blk) {
      const levels = s.level === 'all' ? null : [Number(s.level)];
      const boxW = Math.max(240, s.vw - 48), boxH = Math.max(200, s.vh - 48);
      // Each building is reviewed on its own, one after another.
      const g = this.geometry([blk], boxW, {
        maxM: 13, minM: 4, visibleLevels: levels, hiddenCats: s.hiddenCats,
        selectedBayId: s.bayId, isolate: s.isolate, onPick: this.pick,
        labels: this.props.showZoneLabels !== false
      });
      const baseZoom = this.fitZoom(g, boxW, boxH, s.rx, s.rz);
      const sel = s.bayId ? this._index[s.bayId] : null;
      const selZone = sel && s.zoneId ? sel.bay.zones.find((z) => z.id === s.zoneId) : null;
      const cats = [...new Set(blk.levels.flat().flatMap((bay) => bay.zones.map((z) => z.cat)))];
      const bi = opt.blocks.indexOf(blk), bn = opt.blocks.length;
      const isTeachingBlk = !!(opt.teaching && opt.teaching.blocks.includes(blk));
      const goBlock = (i) => (((this._slots || {}).building || {}).mv && this._slots.building.mv.select(null), this.setState({ blockId: opt.blocks[i].id, bayId: null, zoneId: null, level: 'all', rx: 57, rz: -36, zoom: 1, panX: 0, panY: 0, openInfo: [] }, () => window.scrollTo(0, 0)));
      const kindLabel = (b) => (/^[SDR]/.test(b.typeId) && b.levels.length ? 'Teaching' : b.typeId === 'L' ? 'Library' : b.typeId === 'C' ? 'Administration' : b.kind === 'gym' ? 'Gym' : 'Hall');
      const bays = blk.levels.flat();
      const byCode = {};
      bays.forEach((b) => {
        byCode[b.code] = byCode[b.code] || { code: b.code, name: b.name, count: 0, id: b.id, dims: `${b.w}m × ${b.d}m` };
        byCode[b.code].count++;
      });
      const detail = this.props.matchDetail || 'Requirement breakdown';

      building = {
        optionTabs: opt.blocks.map((b, i) => ({ label: `${i + 1} · ${b.code}`, style: this.btn(b.id === blk.id), onClick: () => goBlock(i) })),
        viewButtons: [
          { label: 'Axonometric', active: s.rx > 20 && s.rx < 80, onClick: () => this.setState({ rx: 57, rz: -36 }) },
          { label: 'Plan', active: s.rx <= 20, onClick: () => this.setState({ rx: 0, rz: 0 }) },
          { label: 'Elevation', active: s.rx >= 80, onClick: () => this.setState({ rx: 89, rz: 0 }) },
          ...(blk.storeys > 1 ? [{ label: 'All levels', active: s.level === 'all', onClick: () => this.setState({ level: 'all' }) },
            ...blk.levels.map((_, i) => ({ label: `L${i + 1}`, active: String(s.level) === String(i), onClick: () => this.setState({ level: i }) }))] : []),
          { label: 'Reset', active: false, onClick: () => this.setState({ rx: 57, rz: -36, zoom: 1, panX: 0, panY: 0, level: 'all', hiddenCats: [], isolate: false }) }
        ].map((v) => ({ ...v, style: this.btn(v.active) })),
        viewerStyle: `position:absolute;inset:0;perspective:2600px;cursor:${s.drag ? (s.drag.pan ? 'grabbing' : 'move') : 'grab'};`,
        onViewerDown: this.startDrag, onViewerWheel: this.wheel, viewerRef: this.viewerRef,
        stageStyle: this.stage(s.rx, s.rz, baseZoom * s.zoom, s.panX, s.panY + 18),
        sceneStyle: this.scene(g), faces: g.faces,
        viewReadout: `AZ ${Math.round(((s.rz % 360) + 360) % 360)}° · EL ${Math.round(90 - s.rx)}° · ${Math.round(baseZoom * s.zoom * 100)}%`,
        legend: cats.map((c) => {
          const cat = D.SPACE_CATS[c]; const hidden = s.hiddenCats.includes(c);
          return {
            label: this.spaceName('design', c, cat.label),
            style: this.legendStyle(hidden),
            swatchStyle: `width:11px;height:11px;flex:none;background:${cat.fill};border:1px solid ${cat.line};opacity:${hidden ? 0.3 : 1};`,
            onClick: () => this.setState((st) => ({ hiddenCats: st.hiddenCats.includes(c) ? st.hiddenCats.filter((x) => x !== c) : [...st.hiddenCats, c] }))
          };
        }),
        optLabel: `Building ${bi + 1} of ${bn} · ${kindLabel(blk)}`,
        optTitle: isTeachingBlk ? opt.title : blk.name,
        optSummary: isTeachingBlk ? opt.summary : blk.summary || '',
        multiBlock: false, keyChars: isTeachingBlk ? opt.characteristics : [blk.form, blk.moe],
        keyStats: blk.levels.length ? [
          { label: 'Teaching spaces', value: String(blk.teachingSpaces) },
          { label: 'Capacity', value: n0(blk.teachingSpaces * req.ratio) },
          { label: 'Gross floor area', value: `${n0(blk.gfa)} m²` },
          { label: 'Footprint', value: `${n0(blk.footprint)} m²` },
          { label: 'Storeys', value: String(blk.storeys) },
          { label: 'Fit (all buildings)', value: `${opt.fit.score}%` }
        ] : [
          { label: 'Code', value: blk.code },
          { label: 'Type', value: blk.form }
        ],
        nextBuildingLabel: bi < bn - 1 ? `Next building · ${opt.blocks[bi + 1].code}` : 'Customise buildings',
        onNextBuilding: () => (bi < bn - 1 ? goBlock(bi + 1) : this.go('customise', { cStep: 0 })),
        prevBuildingLabel: bi > 0 ? `Previous · ${opt.blocks[bi - 1].code}` : 'Options',
        onPrevBuilding: () => (bi > 0 ? goBlock(bi - 1) : this.go('options')),
        ...this.customVals(req, opt, this.mainBlock(opt)),
        ...(screen === 'building' ? this.infoVals(blk, req) : {}),
        ...(screen === 'building' ? this.modelVals(blk, req) : { showMassing: true, hasModel: false }),
        blockTabs: opt.blocks.map((b) => ({ label: b.code || b.typeId,
          style: `background:${b.id === blk.id ? '#fff' : 'transparent'};color:${b.id === blk.id ? INK : '#fff'};border:1px solid ${b.id === blk.id ? '#fff' : 'rgba(255,255,255,0.45)'};padding:8px 12px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;`, onClick: () => this.setState({ blockId: b.id, bayId: null, zoneId: null, level: 'all' }) })),
        infoBlockName: blk.name,
        infoBlockMeta: `${blk.moe} · building ${bi + 1} of ${bn}`,
        infoRows: !blk.levels.length ? [
          { label: 'Building code', value: blk.code },
          { label: 'Type', value: blk.form },
          { label: 'About', value: blk.summary },
          { label: 'Source', value: blk.moe }
        ] : [
          { label: 'Building code', value: blk.code || blk.typeId },
          { label: 'Form', value: blk.form },
          ...(blk.perFloor ? [{ label: 'Per floor', value: blk.perFloor }, { label: 'Module', value: blk.moduleText }] : []),
          { label: 'Gross floor area', value: `${n0(blk.gfa)} m²` },
          { label: 'Net floor area', value: `${n0(blk.nfa)} m²` },
          { label: 'Footprint', value: `${n0(blk.footprint)} m²` },
          { label: 'Dimensions', value: blk.dims },
          { label: 'Storeys', value: String(blk.storeys) },
          { label: 'Physical bays (excl. stair)', value: String(bays.filter((b) => b.moduleKey !== 'STAIR').length) },
          { label: 'Teaching spaces', value: String(blk.teachingSpaces) + (blk.specialistSpaces ? ` (${blk.specialistSpaces} specialist)` : '') },
          { label: 'Teaching layout', value: req.layout.name.replace('Layout ', '').split(' — ')[0] },
          { label: 'Capacity', value: `${n0(blk.teachingSpaces * req.ratio)} students` },
          { label: 'Roof', value: blk.roof },
          { label: 'Services', value: `Zone ${req.climateZone} · default` },
          { label: 'MOE classification', value: blk.moe }
        ],
        schedule: Object.values(byCode).map((m) => ({
          ...m,
          style: `display:flex;flex-direction:column;align-items:flex-start;width:100%;text-align:left;background:transparent;border:1px solid #E4E6E3;padding:11px 12px;color:${INK};`,
          onClick: () => this.setState({ bayId: m.id, zoneId: null })
        })),
        hasSelection: !!sel,
        selectionName: selZone ? selZone.label : sel ? sel.bay.name : '',
        selectionNote: selZone ? `${D.SPACE_CATS[selZone.cat].label} · within ${sel.bay.name}` : sel ? sel.bay.note : '',
        selectionRows: sel ? [
          { label: 'Module code', value: sel.bay.code },
          { label: 'Module size', value: `${sel.bay.w}m × ${sel.bay.d}m` },
          { label: 'Net floor area', value: `${sel.bay.nfa} m²` },
          { label: 'Level', value: `L${sel.bay.level + 1}` },
          ...(selZone ? [{ label: 'Zone area', value: `${Math.round(selZone.fw * sel.bay.w * selZone.fh * sel.bay.d)} m²` }] : [])
        ] : [],
        onClearSelection: () => this.setState({ bayId: null, zoneId: null, isolate: false }),
        onToggleIsolate: () => this.setState((st) => ({ isolate: !st.isolate })),
        isolateLabel: s.isolate ? 'Show all modules' : 'Isolate this module',
        isolateStyle: `margin-top:14px;width:100%;background:${s.isolate ? '#fff' : 'transparent'};color:${s.isolate ? INK : '#fff'};` +
          `border:1px solid ${s.isolate ? '#fff' : 'rgba(255,255,255,0.45)'};padding:12px;font:500 10.5px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase;`,
        showFit: detail !== 'Badge only',
        fitSummary: `${opt.fit.met} of ${opt.fit.total} met · ${opt.fit.score}%`,
        fitLines: opt.fit.lines.map((l) => {
          const pct = l.required ? clamp((l.provided / l.required) * 100, 0, 100) : 100;
          const col = l.status === 'short' ? '#9A3B32' : l.status === 'surplus' ? '#5A6E7A' : INK;
          return {
            label: l.label,
            figures: detail === 'Full working' ? `${l.provided} / ${l.required} ${l.unit}` : `${l.provided} of ${l.required}`,
            text: l.text,
            barStyle: `height:3px;width:${pct}%;background:${col};`
          };
        }),
        ...(screen === 'building' ? this.modelSelectionVals(req) : {})
      };
    }

    return {
      ...base,
      cardBoxRef: this.boxRef('card'),
      sectionNo: s.section + 1, sectionTitle: sec.title, sectionIntro: sec.intro, fields,
      nextLabel: s.section === SECTIONS.length - 1 ? 'Review requirements' : 'Next section',
      onNextSection: () => (s.section === SECTIONS.length - 1 ? this.go('review') : this.setState({ section: s.section + 1 })),
      onPrevSection: () => (s.section === 0 ? this.go('review') : this.setState({ section: s.section - 1 })),
      sections: SECTIONS.map((sc, i) => ({
        n: String(i + 1).padStart(2, '0'), title: sc.title,
        style: `display:flex;align-items:center;gap:12px;width:100%;text-align:left;border:none;padding:13px 22px;` +
          `background:${i === s.section ? '#fff' : 'transparent'};color:${INK};` +
          `border-left:2px solid ${i === s.section ? INK : 'transparent'};font-weight:${i === s.section ? 500 : 400};`,
        onClick: () => this.setState({ section: i })
      })),
      reviewGroups, calcRows,
      reqNotes: [
        ...req.notes
      ],
      optionCards, optionCount: options.length, noOptions: sectionDefs.length === 0,
      pickSectionsList, hasPickSections: sectionDefs.length > 0,
      pickSummary: sectionDefs.length ? 'Selected: ' + (this.option() ? this.option().blocks.map((b) => b.code).join(' + ') : '—') : '',
      onReviewBuildings: () => { const o = this.option(); this.go('building', { blockId: o ? o.blocks[0].id : null, bayId: null, zoneId: null, level: 'all', panX: 0, panY: 0, zoom: 1, openInfo: [] }); },
      optionsIntro: sectionDefs.length
        ? `Options that meet the current requirements for ${req.schoolLabel.toLowerCase()}s, one section per building asked for. Select one in each section, then review the buildings in turn. The final choice also depends on the site, planning and Ministry requirements.`
        : 'No new standard buildings are required from the requirements entered.',
      ...building
    };
  }
}

</script>


</body></html>