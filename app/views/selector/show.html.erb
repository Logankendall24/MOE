                  <div style="display:flex;justify-content:space-between;gap:20px;align-items:baseline;flex-wrap:wrap">
                    <div style="font-size:16px;font-weight:500">{{ f.label }}</div>
                    <div style="font:400 11px/1.4 'IBM Plex Mono',monospace;letter-spacing:0.04em;color:#8A8189;text-align:right">{{ f.hint }}</div>
                  </div>

                  <sc-if value="{{ f.isNumber }}" hint-placeholder-val="{{ true }}">
                    <div style="display:flex;align-items:stretch;gap:0;width:fit-content;border:1px solid #2C112D;background:#fff">
                      <button sc-camel-on-click="{{ f.onMinus }}" style="width:42px;border:none;border-right:1px solid #D7DAD7;background:transparent;font-size:18px;line-height:1" style-hover="background:#F1F3F2">−</button>
                      <input type="number" value="{{ f.value }}" sc-camel-on-change="{{ f.onChange }}" style="width:86px;border:none;text-align:center;font:500 17px/1 'IBM Plex Mono',monospace;padding:12px 4px;background:transparent;color:#2C112D">
                      <span style="display:flex;align-items:center;padding-right:12px;font:400 11px/1 'IBM Plex Mono',monospace;color:#8A8189;text-transform:uppercase;letter-spacing:0.08em">{{ f.unit }}</span>
                      <button sc-camel-on-click="{{ f.onPlus }}" style="width:42px;border:none;border-left:1px solid #D7DAD7;background:transparent;font-size:18px;line-height:1" style-hover="background:#F1F3F2">+</button>
                    </div>
                  </sc-if>

                  <sc-if value="{{ f.isChoice }}" hint-placeholder-val="{{ true }}">
                    <div style="display:flex;flex-wrap:wrap;gap:8px">
                      <sc-for list="{{ f.options }}" as="o" hint-placeholder-count="3">
                        <button sc-camel-on-click="{{ o.onClick }}" style="{{ o.style }}">{{ o.label }}</button>
                      </sc-for>
                    </div>
                  </sc-if>

                  <sc-if value="{{ f.isText }}" hint-placeholder-val="{{ true }}">
                    <input type="text" value="{{ f.value }}" sc-camel-on-change="{{ f.onChange }}" placeholder="{{ f.placeholder }}" style="width:100%;max-width:420px;border:1px solid #2C112D;background:#fff;padding:13px 14px;font-size:15px;color:#2C112D">
                  </sc-if>

                  <sc-if value="{{ f.isTextarea }}" hint-placeholder-val="{{ true }}">
                    <textarea value="{{ f.value }}" sc-camel-on-change="{{ f.onChange }}" placeholder="{{ f.placeholder }}" rows="4" style="width:100%;border:1px solid #2C112D;background:#fff;padding:13px 14px;font-size:15px;line-height:1.5;color:#2C112D;resize:vertical"></textarea>
                  </sc-if>

                  <sc-if value="{{ f.note }}" hint-placeholder-val="{{ false }}">
                    <div style="display:flex;gap:10px;background:#EAEDEA;border-left:2px solid #2C112D;padding:12px 14px;font-size:13px;line-height:1.5;color:#5D5360;max-width:52em">{{ f.note }}</div>
                  </sc-if>
                </div>
              </sc-for>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
              <button sc-camel-on-click="{{ onPrevSection }}" style="background:transparent;border:1px solid #2C112D;color:#2C112D;padding:15px 22px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#E4E0E2">← Back</button>
              <button sc-camel-on-click="{{ onNextSection }}" style="background:#2C112D;border:1px solid #2C112D;color:#fff;padding:15px 24px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#46203F">{{ nextLabel }} →</button>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isReview }}" hint-placeholder-val="{{ true }}">
        <div data-screen-label="Review requirements" style="flex:1;position:relative;z-index:1;padding:0 clamp(22px,4vw,56px) clamp(26px,4vw,52px);background:{{ reviewBg }}">
          <div style="max-width:1180px;margin:0 auto">
            <div style="display:flex;margin:0 0 26px;margin-left:calc(-1 * clamp(22px,4vw,56px))">
              <div style="background:#2C112D;color:#fff;border-radius:0 0 34px 0;padding:clamp(22px,3vw,34px) clamp(40px,4vw,58px) clamp(22px,3vw,32px) clamp(22px,4vw,56px)">
                <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.6)">Step 02</div>
                <h2 style="margin:12px 0 0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(28px,3.4vw,46px);font-weight:800;line-height:1.05;letter-spacing:-0.028em">Review requirements</h2>
              </div>
            </div>
            <div style="display:flex;gap:14px;margin:0 0 34px;background:#EDE7EE;border-left:4px solid #2C112D;padding:16px 20px;max-width:52em">
              <p style="margin:0;font-size:16px;line-height:1.5;color:#3F3542;text-wrap:pretty">Check the information entered and the requirement calculated from it. Amend anything before the standard design rules are applied.</p>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:24px;align-items:start">
              <sc-for list="{{ reviewGroups }}" as="g" hint-placeholder-count="4">
                <div style="background:#fff;border:1px solid #D7DAD7">
                  <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;border-bottom:1px solid #D7DAD7;background:#EAEDEA">
                    <div style="font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase">{{ g.title }}</div>
                    <button sc-camel-on-click="{{ g.onEdit }}" style="background:transparent;border:1px solid #B6B0B4;color:#2C112D;padding:6px 10px;font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.1em;text-transform:uppercase" style-hover="border-color:#2C112D">Edit</button>
                  </div>
                  <div style="padding:6px 18px 14px">
                    <sc-for list="{{ g.rows }}" as="r" hint-placeholder-count="3">
                      <div style="display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid #EDEFEC;font-size:14px">
                        <span style="color:#5D5360">{{ r.label }}</span>
                        <span style="font:500 14px/1.3 'IBM Plex Mono',monospace;text-align:right">{{ r.value }}</span>
                      </div>
                    </sc-for>
                  </div>
                </div>
              </sc-for>

              <div style="background:#2C112D;color:#fff;border:1px solid #2C112D">
                <div style="padding:14px 18px;border-bottom:1px solid rgba(255,255,255,0.22);font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.12em;text-transform:uppercase">Requirement calculation</div>
                <div style="padding:6px 18px 16px">
                  <sc-for list="{{ calcRows }}" as="r" hint-placeholder-count="5">
                    <div style="display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,0.14);font-size:14px">
                      <span style="color:rgba(255,255,255,0.7)">{{ r.label }}</span>
                      <span style="font:500 14px/1.3 'IBM Plex Mono',monospace;text-align:right">{{ r.value }}</span>
                    </div>
                  </sc-for>
                  <sc-for list="{{ reqNotes }}" as="n" hint-placeholder-count="0">
                    <div style="margin-top:14px;font-size:12.5px;line-height:1.5;color:rgba(255,255,255,0.62);border-left:2px solid rgba(255,255,255,0.35);padding-left:10px">{{ n }}</div>
                  </sc-for>
                </div>
              </div>
            </div>

            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:32px">
              <button sc-camel-on-click="{{ onBackToReq }}" style="background:transparent;border:1px solid #2C112D;color:#2C112D;padding:15px 22px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#E4E0E2">← Amend requirements</button>
              <button sc-camel-on-click="{{ onCalculate }}" style="background:#2C112D;border:1px solid #2C112D;color:#fff;padding:15px 24px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="background:#46203F">Find building options →</button>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{ isOptions }}" hint-placeholder-val="{{ true }}">
