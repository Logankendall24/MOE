                      <button sc-camel-on-click="{{ pc.onClick }}" style="{{ pc.style }}">
                        <span style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase;opacity:0.7">{{ pc.tag }}</span>
                        <span style="font-size:18px;font-weight:500;line-height:1.25">{{ pc.label }}</span>
                        <span style="font-size:14px;line-height:1.5;opacity:0.8;text-wrap:pretty">{{ pc.note }}</span>
                      </button>
                    </sc-for>
                  </div>
                </sc-if>
                <sc-if value="{{ ps.isTeaching }}" hint-placeholder-val="{{ true }}">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:22px;margin-top:20px;align-items:start">
