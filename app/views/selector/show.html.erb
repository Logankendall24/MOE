  <sc-if value="{{ isDirect }}" hint-placeholder-val="{{ false }}">
    <div data-screen-label="Direct entry" style="position:relative;min-height:100vh;background:#2C112D url(&quot;/design/1278eb3b-8e9a-4746-a147-8fbefabcff61.png&quot;) center center / cover no-repeat;color:#fff;display:flex;flex-direction:column;padding:clamp(24px,4vw,56px) clamp(28px,5vw,80px)">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap">
        <button sc-camel-on-click="{{ onHome }}" style="background:transparent;border:none;padding:0;display:block;cursor:pointer">
          <img src="/design/3c68cb50-2e72-4854-bf69-d4d6d8cb5418.png" alt="Ministry of Education" style="width:clamp(150px,14vw,210px);height:auto;display:block">
        </button>
      </div>
      <div style="flex:1;display:flex;flex-direction:column;justify-content:center;max-width:640px;gap:clamp(14px,2vw,24px);padding:clamp(36px,6vw,80px) 0">
        <h1 style="margin:0;font-family:'Figtree','Instrument Sans',Helvetica,Arial,sans-serif;font-size:clamp(26px,4vw,52px);font-weight:800;line-height:1.06;letter-spacing:-0.028em">Enter your building module code</h1>
        <p style="margin:0;font-size:16px;line-height:1.55;color:rgba(255,255,255,0.72);max-width:36em">If the Ministry has already given you the standard design building module, enter its code below, then choose the school’s location. The building details load straight away, ready to review and customise.</p>
        <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-top:clamp(8px,1.4vw,18px)">01 · Building module code</div>
        <input type="text" value="{{ directCode }}" sc-camel-on-input="{{ onDirectChange }}" sc-camel-on-key-down="{{ onDirectKey }}" placeholder="XX-XX, e.g. S2-B5" style="width:100%;padding:16px 20px;font:500 18px/1 'IBM Plex Mono',monospace;letter-spacing:0.08em;text-transform:uppercase;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.35);color:#fff;outline:none" />
        <div style="font:400 12.5px/1.5 'IBM Plex Mono',monospace;color:rgba(255,255,255,0.5)">Format XX-XX: the building type first (S1, S2, S3, D1, D2, D3), then the rest of the code. Add gym and hall codes with + (e.g. S2-B5 + G1 + H3).</div>
        <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-top:clamp(10px,1.6vw,20px)">02 · School location</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,190px),1fr));gap:8px">
          <sc-for list="{{ directRegions }}" as="rg" hint-placeholder-count="7">
            <button sc-camel-on-click="{{ rg.onClick }}" style="{{ rg.style }}"><span style="font-size:14px;line-height:1.3">{{ rg.label }}</span><span style="{{ rg.noteStyle }}">{{ rg.note }}</span></button>
          </sc-for>
        </div>
        <div>
          <button sc-camel-on-click="{{ onDirectSubmit }}" style="margin-top:clamp(8px,1.4vw,16px);background:#fff;color:#2C112D;border:1px solid #fff;padding:16px 28px;font:500 12px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase;white-space:nowrap" style-hover="background:#F1D9E6;border-color:#F1D9E6">Load building →</button>
        </div>
        <sc-if value="{{ hasDirectError }}" hint-placeholder-val="{{ false }}">
          <div style="font:400 13px/1.5 'IBM Plex Mono',monospace;color:#F1D9E6">{{ directError }}</div>
        </sc-if>
        <div style="margin-top:clamp(14px,2vw,28px);padding-top:clamp(14px,2vw,24px);border-top:1px solid rgba(255,255,255,0.15)">
          <div style="font:500 10px/1 'IBM Plex Mono',monospace;letter-spacing:0.16em;text-transform:uppercase;color:rgba(255,255,255,0.45);margin-bottom:12px">Supported codes</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px 24px;font-size:13px;line-height:1.5;color:rgba(255,255,255,0.6)">
            <div><strong style="color:rgba(255,255,255,0.85)">S1</strong> — Single-depth, 1 storey</div>
            <div><strong style="color:rgba(255,255,255,0.85)">S2</strong> — Single-depth, 2 storeys</div>
            <div><strong style="color:rgba(255,255,255,0.85)">S3</strong> — Single-depth, 3 storeys</div>
            <div><strong style="color:rgba(255,255,255,0.85)">D1</strong> — Double-depth, 1 storey</div>
            <div><strong style="color:rgba(255,255,255,0.85)">D2</strong> — Double-depth, 2 storeys</div>
            <div><strong style="color:rgba(255,255,255,0.85)">D3</strong> — Double-depth, 3 storeys</div>
            <div><strong style="color:rgba(255,255,255,0.85)">OMB 2.5</strong> — Relocatable, 1–6 modules</div>
            <div><strong style="color:rgba(255,255,255,0.85)">G1 · G2 · G4</strong> — Gyms</div>
            <div><strong style="color:rgba(255,255,255,0.85)">H3 · H8 · H9</strong> — Halls</div>
          </div>
          <div style="margin-top:12px;display:grid;gap:4px;font-size:12px;line-height:1.5;color:rgba(255,255,255,0.45)">
            <div>S codes: module letter then length — B for primary (7.2 m × 12 m), A for secondary / intermediate (7.2 m × 10.3 m). S2-B3.5 = 3 teaching spaces + a half-bay per floor; S2-B5 = 4 teaching spaces + a resource / admin / toilet bay per floor.</div>
            <div>D codes (secondary / intermediate only): modules per row, 3–6 — e.g. D1-3, D2-4.</div>
          </div>
        </div>
      </div>
      <div>
        <button sc-camel-on-click="{{ onDirectBack }}" style="background:transparent;border:1px solid rgba(255,255,255,0.35);color:rgba(255,255,255,0.7);padding:12px 20px;font:500 11px/1 'IBM Plex Mono',monospace;letter-spacing:0.14em;text-transform:uppercase" style-hover="border-color:rgba(255,255,255,0.7);color:#fff">← Back</button>
      </div>
    </div>
  </sc-if>

